@model SukkarFamily.ViewModel.HomeIndexViewModel
@{
    ViewData["Title"] = "عائلة سكر - الصفحة الرئيسية";
    Layout = "~/Views/Shared/_LayoutArabic.cshtml";
}

<!-- Main Content Section -->
<div class="row">
    <!-- Main Content -->
    <div class="col-lg-8">
        <!-- Family Heritage Section -->
        <section class="heritage-section fade-in-up">
            <div class="content">
                <h2 class="arabic-title">
                    <i class="fas fa-star-and-crescent text-gold me-3"></i>
                    لمحة عن عائلة سكر الكريمة
                </h2>
                
                <div class="row align-items-center">
                    <div class="col-md-4 text-center mb-4">
                        <div class="heritage-image-container">
                            <img src="~/img/family-heritage.jpg" alt="تراث العائلة" class="img-fluid rounded-circle shadow-lg" style="width: 200px; height: 200px; object-fit: cover; border: 4px solid var(--islamic-gold);">
                            <div class="islamic-pattern-overlay"></div>
                        </div>
                    </div>
                    <div class="col-md-8">
                        <div class="arabic-text">
                            <p class="lead text-gold">
                                <strong>آل سكر</strong> - من الأسر الإسلامية العريقة
                            </p>
                            
                            <p>
                                من الأسر الإسلامية البيروتية واللبنانية والعربية، تعود بجذورها إلى القبائل العربية التي أسهمت في فتوحات بلاد الشام ومصر والعراق والمغرب العربي والأندلس. كما أنها من الأسر المنسوبة إلى <strong class="text-gold">آل البيت النبوي الشريف</strong>.
                            </p>
                            
                            <p>
                                وفي التاريخ الحديث والمعاصر اشتهرت الأسرة بأنها دمشقية توطنت في حي <strong class="text-gold">الصالحية والميدان</strong>، كما توطن فرع منها في <strong class="text-gold">بيروت المحروسة وبعلبك</strong> وسواها من مناطق لبنانية وسورية وعربية.
                            </p>
                        </div>
                    </div>
                </div>
                
                <!-- Genealogy Section -->
                <div class="mt-4 p-4 bg-light rounded-3">
                    <h4 class="text-gold mb-3">
                        <i class="fas fa-scroll me-2"></i>النسب الشريف
                    </h4>
                    <div class="arabic-text">
                        <p>
                            تعود بجذورها إلى جدها الأعلى <strong class="text-gold">السيد حسن الملقب بالسكر</strong> وهو ابن السيد شرف الدين قباد بن مصطفى الأمير ابن شرف الدين موسى بن إبراهيم شيخ ابريك المهاجر من الغرب إلى دمشق...
                        </p>
                        <p>
                            ويستمر النسب إلى <strong class="text-gold">القطب عز الدين أحمد الصيادي</strong> سبط الحضرة الرفاعية الحسيني... ويستمر النسب إلى أن يصل إلى <strong class="text-gold">الإمام موسى الكاظم</strong> ابن الإمام جعفر الصادق ابن الإمام محمد الباقر ابن الإمام علي زين العابدين السجاد ابن <strong class="text-gold">الإمام الحسين</strong> (رضي الله عنهم أجمعين).
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Quick Actions -->
        <section class="quick-actions-section fade-in-up-delay">
            <div class="row">
                <div class="col-md-6 mb-4">
                    <div class="card-islamic h-100">
                        <div class="card-header">
                            <h5><i class="fas fa-sitemap"></i>شجرة العائلة</h5>
                        </div>
                        <div class="card-body text-center">
                            <i class="fas fa-tree text-gold mb-3" style="font-size: 3rem;"></i>
                            <p>استكشف شجرة العائلة الكاملة مع تفاصيل الأجيال والأنساب</p>
                            <a href="@Url.Action("Tree", "Persone")" class="btn btn-gold">
                                <i class="fas fa-eye me-2"></i>عرض الشجرة
                            </a>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 mb-4">
                    <div class="card-islamic h-100">
                        <div class="card-header">
                            <h5><i class="fas fa-users"></i>أفراد العائلة</h5>
                        </div>
                        <div class="card-body text-center">
                            <i class="fas fa-users text-gold mb-3" style="font-size: 3rem;"></i>
                            <p>تصفح قائمة أفراد العائلة مع معلوماتهم وتفاصيلهم</p>
                            <a href="@Url.Action("Index", "Persone")" class="btn btn-gold">
                                <i class="fas fa-list me-2"></i>عرض الأفراد
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
    
    <!-- Sidebar -->
    <div class="col-lg-4">
        <!-- Latest News -->
        <section class="news-sidebar fade-in-up">
            <div class="card-islamic">
                <div class="card-header">
                    <h5>
                        <i class="fas fa-newspaper"></i>آخر الأخبار
                        <a href="@Url.Action("Index", "News")" class="btn btn-sm btn-outline-light me-auto">
                            عرض الكل <i class="fas fa-arrow-left me-1"></i>
                        </a>
                    </h5>
                </div>
                <div class="card-body">
                    @if (Model.News != null && Model.News.Any())
                    {
                        @foreach (var news in Model.News.Take(4))
                        {
                            <div class="news-item mb-3 pb-3 border-bottom">
                                <h6 class="news-title">
                                    <a href="@Url.Action("Details", "News", new { id = news.ID })" class="text-decoration-none text-gold">
                                        @news.Title
                                    </a>
                                </h6>
                                <p class="news-excerpt text-muted small">
                                    @{
                                        var excerpt = news.Text?.Length > 100 ? news.Text.Substring(0, 100) + "..." : news.Text;
                                    }
                                    @excerpt
                                </p>
                                <small class="text-muted">
                                    <i class="fas fa-calendar-alt me-1"></i>
                                    @DateTime.Now.ToString("dd/MM/yyyy", new System.Globalization.CultureInfo("ar-SA"))
                                </small>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="fas fa-newspaper text-muted" style="font-size: 3rem;"></i>
                            <p class="text-muted mt-2">لا توجد أخبار حاليًا</p>
                            <a href="@Url.Action("Create", "News")" class="btn btn-gold btn-sm">
                                <i class="fas fa-plus me-1"></i>إضافة خبر
                            </a>
                        </div>
                    }
                </div>
            </div>
        </section>

        <!-- Family Statistics -->
        <section class="statistics-section mt-4 fade-in-up-delay">
            <div class="card-islamic">
                <div class="card-header">
                    <h5><i class="fas fa-chart-bar"></i>إحصائيات العائلة</h5>
                </div>
                <div class="card-body">
                    <div class="stat-item d-flex justify-content-between align-items-center mb-3">
                        <div class="d-flex align-items-center">
                            <i class="fas fa-users text-gold me-2"></i>
                            <span>إجمالي الأفراد</span>
                        </div>
                        <span class="badge bg-gold text-dark fs-6">@Model.FamilyStatistics.TotalMembers</span>
                    </div>
                    <div class="stat-item d-flex justify-content-between align-items-center mb-3">
                        <div class="d-flex align-items-center">
                            <i class="fas fa-layer-group text-gold me-2"></i>
                            <span>عدد الأجيال</span>
                        </div>
                        <span class="badge bg-gold text-dark fs-6">@Model.FamilyStatistics.TotalGenerations</span>
                    </div>
                    <div class="stat-item d-flex justify-content-between align-items-center mb-3">
                        <div class="d-flex align-items-center">
                            <i class="fas fa-male text-gold me-2"></i>
                            <span>الذكور</span>
                        </div>
                        <span class="badge bg-gold text-dark fs-6">@Model.FamilyStatistics.MaleMembers</span>
                    </div>
                    <div class="stat-item d-flex justify-content-between align-items-center mb-3">
                        <div class="d-flex align-items-center">
                            <i class="fas fa-female text-gold me-2"></i>
                            <span>الإناث</span>
                        </div>
                        <span class="badge bg-gold text-dark fs-6">@Model.FamilyStatistics.FemaleMembers</span>
                    </div>
                    <div class="stat-item d-flex justify-content-between align-items-center mb-3">
                        <div class="d-flex align-items-center">
                            <i class="fas fa-map-marker-alt text-gold me-2"></i>
                            <span>المدن والمناطق</span>
                        </div>
                        <span class="badge bg-gold text-dark fs-6">@Model.FamilyStatistics.UniqueLocations</span>
                    </div>
                    <div class="stat-item d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center">
                            <i class="fas fa-crown text-gold me-2"></i>
                            <span>جد العائلة</span>
                        </div>
                        <span class="badge bg-gold text-dark fs-6" style="font-size: 0.8rem;">@Model.FamilyStatistics.OldestMemberName</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- Additional Family Details -->
        <section class="family-details-section mt-4 fade-in-up">
            <div class="card-islamic">
                <div class="card-header">
                    <h5><i class="fas fa-info-circle"></i>تفاصيل إضافية</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <div class="detail-item p-3 rounded bg-light">
                                <div class="detail-icon text-center mb-2">
                                    <i class="fas fa-user-tie text-gold" style="font-size: 2rem;"></i>
                                </div>
                                <h6 class="text-center text-gold mb-2">أكبر أفراد العائلة</h6>
                                <p class="text-center mb-0 font-weight-bold">@Model.FamilyStatistics.OldestMemberName</p>
                                <small class="text-muted d-block text-center">الجيل الأول</small>
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="detail-item p-3 rounded bg-light">
                                <div class="detail-icon text-center mb-2">
                                    <i class="fas fa-child text-gold" style="font-size: 2rem;"></i>
                                </div>
                                <h6 class="text-center text-gold mb-2">أحدث جيل</h6>
                                <p class="text-center mb-0 font-weight-bold">@Model.FamilyStatistics.YoungestMemberName</p>
                                <small class="text-muted d-block text-center">الجيل الحالي</small>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Progress bar showing generations -->
                    <div class="mt-4">
                        <h6 class="mb-3 text-gold">
                            <i class="fas fa-chart-line me-2"></i>نمو العائلة عبر الأجيال
                        </h6>
                        <div class="generation-progress">
                            <div class="progress mb-2" style="height: 25px;">
                                <div class="progress-bar" role="progressbar" 
                                     style="width: @(((double)Model.FamilyStatistics.TotalGenerations / 10.0) * 100)%; background: linear-gradient(45deg, var(--islamic-gold), var(--islamic-green));"
                                     aria-valuenow="@Model.FamilyStatistics.TotalGenerations" 
                                     aria-valuemin="0" 
                                     aria-valuemax="10">
                                    <span class="text-dark fw-bold">@Model.FamilyStatistics.TotalGenerations أجيال</span>
                                </div>
                            </div>
                            <small class="text-muted">تطور العائلة عبر الزمن</small>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Contact Info -->
        <section class="contact-section mt-4 fade-in-up">
            <div class="card-islamic">
                <div class="card-header">
                    <h5><i class="fas fa-envelope"></i>معلومات التواصل</h5>
                </div>
                <div class="card-body">
                    <div class="contact-item mb-3">
                        <i class="fas fa-phone text-gold me-2"></i>
                        <a href="tel:00963991231134" class="text-decoration-none text-dark">
                            00963991231134
                        </a>
                    </div>
                    <div class="contact-item mb-3">
                        <i class="fas fa-envelope text-gold me-2"></i>
                        <a href="mailto:hamzasukkar@gmail.com" class="text-decoration-none text-dark">
                            hamzasukkar@gmail.com
                        </a>
                    </div>
                    <div class="contact-item">
                        <i class="fas fa-map-marker-alt text-gold me-2"></i>
                        <span>دمشق، سوريا</span>
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>

<!-- Image Gallery Section -->
<section class="gallery-section mt-5 fade-in-up">
    <div class="card-islamic">
        <div class="card-header">
            <h5><i class="fas fa-images"></i>معرض الصور التراثية</h5>
        </div>
        <div class="card-body">
            <div class="row" id="galleryContainer">
                <!-- Main heritage images -->
                <div class="col-lg-4 col-md-6 mb-3">
                    <div class="gallery-item">
                        <img src="~/img/slide1.jpg" alt="صورة تراثية للعائلة" class="img-fluid rounded gallery-image">
                        <div class="gallery-overlay">
                            <i class="fas fa-search-plus"></i>
                        </div>
                    </div>
                </div>
                
                <div class="col-lg-4 col-md-6 mb-3">
                    <div class="gallery-item">
                        <img src="~/img/slide2.jpg" alt="صورة تراثية للعائلة" class="img-fluid rounded gallery-image">
                        <div class="gallery-overlay">
                            <i class="fas fa-search-plus"></i>
                        </div>
                    </div>
                </div>
                
                <div class="col-lg-4 col-md-6 mb-3">
                    <div class="gallery-item">
                        <img src="~/img/slide3.jpg" alt="صورة تراثية للعائلة" class="img-fluid rounded gallery-image">
                        <div class="gallery-overlay">
                            <i class="fas fa-search-plus"></i>
                        </div>
                    </div>
                </div>
                
                <!-- Gallery images -->
                <div class="col-lg-4 col-md-6 mb-3">
                    <div class="gallery-item">
                        <img src="~/img/gal1.jpg" alt="صورة من معرض العائلة" class="img-fluid rounded gallery-image">
                        <div class="gallery-overlay">
                            <i class="fas fa-search-plus"></i>
                        </div>
                    </div>
                </div>
                
                <div class="col-lg-4 col-md-6 mb-3">
                    <div class="gallery-item">
                        <img src="~/img/gal2.jpg" alt="صورة من معرض العائلة" class="img-fluid rounded gallery-image">
                        <div class="gallery-overlay">
                            <i class="fas fa-search-plus"></i>
                        </div>
                    </div>
                </div>
                
                <div class="col-lg-4 col-md-6 mb-3">
                    <div class="gallery-item">
                        <img src="~/img/gal3.jpg" alt="صورة من معرض العائلة" class="img-fluid rounded gallery-image">
                        <div class="gallery-overlay">
                            <i class="fas fa-search-plus"></i>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Gallery Navigation -->
            <div class="gallery-footer text-center mt-4">
                <button type="button" class="btn btn-outline-gold" id="loadMoreBtn">
                    <i class="fas fa-plus me-2"></i>عرض المزيد من الصور
                </button>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Debug: Check if images exist
            console.log('Gallery images found:', document.querySelectorAll('.gallery-image').length);
            document.querySelectorAll('.gallery-image').forEach((img, index) => {
                console.log(`Image ${index + 1}:`, img.src);
                img.addEventListener('load', function() {
                    console.log('✓ Image loaded successfully:', this.src);
                });
                img.addEventListener('error', function() {
                    console.log('✗ Failed to load image:', this.src);
                });
            });
            
            // Add smooth scrolling
            document.querySelectorAll('a[href^="#"]').forEach(anchor => {
                anchor.addEventListener('click', function (e) {
                    e.preventDefault();
                    document.querySelector(this.getAttribute('href')).scrollIntoView({
                        behavior: 'smooth'
                    });
                });
            });

            // Simple gallery functionality
            const galleryItems = document.querySelectorAll('.gallery-item');
            galleryItems.forEach(item => {
                item.addEventListener('click', function() {
                    const img = this.querySelector('.gallery-image');
                    if (img) {
                        openImageModal(img.src, img.alt);
                    }
                });
            });

            // Load more images functionality
            const loadMoreBtn = document.getElementById('loadMoreBtn');
            if (loadMoreBtn) {
                loadMoreBtn.addEventListener('click', function() {
                    loadMoreImages();
                });
            }
        });

        function openImageModal(src, alt) {
            // Create a simple modal for image viewing
            const modal = document.createElement('div');
            modal.className = 'image-modal';
            modal.innerHTML = `
                <div class="modal-backdrop" onclick="closeImageModal()"></div>
                <div class="modal-content">
                    <button class="modal-close" onclick="closeImageModal()">&times;</button>
                    <img src="${src}" alt="${alt}" class="modal-image">
                    <div class="modal-caption">${alt}</div>
                </div>
            `;
            document.body.appendChild(modal);
            document.body.style.overflow = 'hidden';
        }

        function closeImageModal() {
            const modal = document.querySelector('.image-modal');
            if (modal) {
                modal.remove();
                document.body.style.overflow = 'auto';
            }
        }

        function loadMoreImages() {
            // Additional gallery images that exist in your directory
            const additionalImages = [
                { src: '~/img/gal4.jpg', alt: 'صورة من معرض العائلة 4' },
                { src: '~/img/gal5.jpg', alt: 'صورة من معرض العائلة 5' },
                { src: '~/img/gal6.jpg', alt: 'صورة من معرض العائلة 6' },
                { src: '~/img/img1.jpg', alt: 'صورة تراثية إضافية 1' },
                { src: '~/img/img2.jpg', alt: 'صورة تراثية إضافية 2' },
                { src: '~/img/pic1.jpg', alt: 'صورة تراثية إضافية 3' }
            ];

            const galleryContainer = document.getElementById('galleryContainer');
            const loadMoreBtn = document.getElementById('loadMoreBtn');
            
            additionalImages.forEach((imageData, index) => {
                setTimeout(() => {
                    const colDiv = document.createElement('div');
                    colDiv.className = 'col-lg-4 col-md-6 mb-3';
                    colDiv.style.opacity = '0';
                    colDiv.innerHTML = `
                        <div class="gallery-item">
                            <img src="${imageData.src}" alt="${imageData.alt}" class="gallery-image" style="aspect-ratio: 1; object-fit: cover;" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                            <div class="image-placeholder" style="display: none;">
                                <i class="fas fa-image"></i>
                                <span>${imageData.alt}</span>
                            </div>
                            <div class="gallery-overlay">
                                <i class="fas fa-search-plus"></i>
                            </div>
                        </div>
                    `;
                    
                    galleryContainer.appendChild(colDiv);
                    
                    // Animate in
                    setTimeout(() => {
                        colDiv.style.transition = 'opacity 0.5s ease';
                        colDiv.style.opacity = '1';
                    }, 100);
                    
                    // Add click event
                    const galleryItem = colDiv.querySelector('.gallery-item');
                    galleryItem.addEventListener('click', function() {
                        const img = this.querySelector('.gallery-image');
                        if (img && img.style.display !== 'none') {
                            openImageModal(img.src, img.alt);
                        }
                    });
                    
                }, index * 200); // Stagger the animations
            });
            
            // Hide load more button
            loadMoreBtn.style.display = 'none';
            IslamicSite.showToast('تم تحميل المزيد من الصور', 'success');
        };
    </script>
    
    <style>
        .bg-gold {
            background-color: var(--islamic-gold) !important;
        }
        
        .gallery-item {
            position: relative;
            cursor: pointer;
            overflow: hidden;
            border-radius: 12px;
            transition: all 0.3s ease;
            background: #f8f9fa;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        }
        
        .gallery-item:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
        }
        
        .gallery-image {
            width: 100%;
            height: 200px;
            object-fit: cover;
            border-radius: 12px;
            display: block !important;
            opacity: 1 !important;
        }
        
        .gallery-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(26, 71, 42, 0.85);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.8rem;
            opacity: 0;
            transition: opacity 0.3s ease;
            border-radius: 12px;
        }
        
        .gallery-item:hover .gallery-overlay {
            opacity: 1;
        }
        
        .btn-outline-gold {
            border-color: var(--islamic-gold);
            color: var(--islamic-gold);
            transition: all 0.3s ease;
        }
        
        .btn-outline-gold:hover {
            background: var(--islamic-gold);
            color: var(--islamic-dark);
            transform: translateY(-2px);
        }

        /* Image Modal Styles */
        .image-modal {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 2000;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .modal-backdrop {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.9);
            cursor: pointer;
        }

        .modal-content {
            position: relative;
            max-width: 90vw;
            max-height: 90vh;
            background: white;
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
        }

        .modal-close {
            position: absolute;
            top: 15px;
            right: 15px;
            background: rgba(0, 0, 0, 0.7);
            color: white;
            border: none;
            border-radius: 50%;
            width: 40px;
            height: 40px;
            font-size: 1.5rem;
            cursor: pointer;
            z-index: 10;
            transition: background 0.3s ease;
        }

        .modal-close:hover {
            background: rgba(0, 0, 0, 0.9);
        }

        .modal-image {
            max-width: 100%;
            max-height: 80vh;
            display: block;
        }

        .modal-caption {
            padding: 20px;
            text-align: center;
            background: var(--islamic-green);
            color: white;
            font-weight: 600;
        }
        
        .heritage-image-container {
            position: relative;
        }
        
        .islamic-pattern-overlay {
            position: absolute;
            top: -10px;
            left: -10px;
            right: -10px;
            bottom: -10px;
            border: 2px solid var(--islamic-gold);
            border-radius: 50%;
            opacity: 0.3;
            animation: pulse 2s infinite;
        }
        
        @@keyframes pulse {
            0% { transform: scale(1); opacity: 0.3; }
            50% { transform: scale(1.05); opacity: 0.6; }
            100% { transform: scale(1); opacity: 0.3; }
        }
    </style>
}