@model IEnumerable<SukkarFamily.Models.News>
@{
    ViewData["Title"] = "عائلة سكر - الصفحة الرئيسية";
    Layout = "~/Views/Shared/_LayoutArabic.cshtml";
}

<!-- Main Content Section -->
<div class="row">
    <!-- Main Content -->
    <div class="col-lg-8">
        <!-- Family Heritage Section -->
        <section class="heritage-section fade-in-up">
            <div class="content">
                <h2 class="arabic-title">
                    <i class="fas fa-star-and-crescent text-gold me-3"></i>
                    لمحة عن عائلة سكر الكريمة
                </h2>
                
                <div class="row align-items-center">
                    <div class="col-md-4 text-center mb-4">
                        <div class="heritage-image-container">
                            <img src="~/img/family-heritage.jpg" alt="تراث العائلة" class="img-fluid rounded-circle shadow-lg" style="width: 200px; height: 200px; object-fit: cover; border: 4px solid var(--islamic-gold);">
                            <div class="islamic-pattern-overlay"></div>
                        </div>
                    </div>
                    <div class="col-md-8">
                        <div class="arabic-text">
                            <p class="lead text-gold">
                                <strong>آل سكر</strong> - من الأسر الإسلامية العريقة
                            </p>
                            
                            <p>
                                من الأسر الإسلامية البيروتية واللبنانية والعربية، تعود بجذورها إلى القبائل العربية التي أسهمت في فتوحات بلاد الشام ومصر والعراق والمغرب العربي والأندلس. كما أنها من الأسر المنسوبة إلى <strong class="text-gold">آل البيت النبوي الشريف</strong>.
                            </p>
                            
                            <p>
                                وفي التاريخ الحديث والمعاصر اشتهرت الأسرة بأنها دمشقية توطنت في حي <strong class="text-gold">الصالحية والميدان</strong>، كما توطن فرع منها في <strong class="text-gold">بيروت المحروسة وبعلبك</strong> وسواها من مناطق لبنانية وسورية وعربية.
                            </p>
                        </div>
                    </div>
                </div>
                
                <!-- Genealogy Section -->
                <div class="mt-4 p-4 bg-light rounded-3">
                    <h4 class="text-gold mb-3">
                        <i class="fas fa-scroll me-2"></i>النسب الشريف
                    </h4>
                    <div class="arabic-text">
                        <p>
                            تعود بجذورها إلى جدها الأعلى <strong class="text-gold">السيد حسن الملقب بالسكر</strong> وهو ابن السيد شرف الدين قباد بن مصطفى الأمير ابن شرف الدين موسى بن إبراهيم شيخ ابريك المهاجر من الغرب إلى دمشق...
                        </p>
                        <p>
                            ويستمر النسب إلى <strong class="text-gold">القطب عز الدين أحمد الصيادي</strong> سبط الحضرة الرفاعية الحسيني... ويستمر النسب إلى أن يصل إلى <strong class="text-gold">الإمام موسى الكاظم</strong> ابن الإمام جعفر الصادق ابن الإمام محمد الباقر ابن الإمام علي زين العابدين السجاد ابن <strong class="text-gold">الإمام الحسين</strong> (رضي الله عنهم أجمعين).
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Quick Actions -->
        <section class="quick-actions-section fade-in-up-delay">
            <div class="row">
                <div class="col-md-6 mb-4">
                    <div class="card-islamic h-100">
                        <div class="card-header">
                            <h5><i class="fas fa-sitemap"></i>شجرة العائلة</h5>
                        </div>
                        <div class="card-body text-center">
                            <i class="fas fa-tree text-gold mb-3" style="font-size: 3rem;"></i>
                            <p>استكشف شجرة العائلة الكاملة مع تفاصيل الأجيال والأنساب</p>
                            <a href="@Url.Action("Tree", "Persone")" class="btn btn-gold">
                                <i class="fas fa-eye me-2"></i>عرض الشجرة
                            </a>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 mb-4">
                    <div class="card-islamic h-100">
                        <div class="card-header">
                            <h5><i class="fas fa-users"></i>أفراد العائلة</h5>
                        </div>
                        <div class="card-body text-center">
                            <i class="fas fa-users text-gold mb-3" style="font-size: 3rem;"></i>
                            <p>تصفح قائمة أفراد العائلة مع معلوماتهم وتفاصيلهم</p>
                            <a href="@Url.Action("Index", "Persone")" class="btn btn-gold">
                                <i class="fas fa-list me-2"></i>عرض الأفراد
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
    
    <!-- Sidebar -->
    <div class="col-lg-4">
        <!-- Latest News -->
        <section class="news-sidebar fade-in-up">
            <div class="card-islamic">
                <div class="card-header">
                    <h5>
                        <i class="fas fa-newspaper"></i>آخر الأخبار
                        <a href="@Url.Action("Index", "News")" class="btn btn-sm btn-outline-light me-auto">
                            عرض الكل <i class="fas fa-arrow-left me-1"></i>
                        </a>
                    </h5>
                </div>
                <div class="card-body">
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var news in Model.Take(4))
                        {
                            <div class="news-item mb-3 pb-3 border-bottom">
                                <h6 class="news-title">
                                    <a href="@Url.Action("Details", "News", new { id = news.ID })" class="text-decoration-none text-gold">
                                        @news.Title
                                    </a>
                                </h6>
                                <p class="news-excerpt text-muted small">
                                    @{
                                        var excerpt = news.Text?.Length > 100 ? news.Text.Substring(0, 100) + "..." : news.Text;
                                    }
                                    @excerpt
                                </p>
                                <small class="text-muted">
                                    <i class="fas fa-calendar-alt me-1"></i>
                                    @DateTime.Now.ToString("dd/MM/yyyy", new System.Globalization.CultureInfo("ar-SA"))
                                </small>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="fas fa-newspaper text-muted" style="font-size: 3rem;"></i>
                            <p class="text-muted mt-2">لا توجد أخبار حاليًا</p>
                            <a href="@Url.Action("Create", "News")" class="btn btn-gold btn-sm">
                                <i class="fas fa-plus me-1"></i>إضافة خبر
                            </a>
                        </div>
                    }
                </div>
            </div>
        </section>

        <!-- Family Statistics -->
        <section class="statistics-section mt-4 fade-in-up-delay">
            <div class="card-islamic">
                <div class="card-header">
                    <h5><i class="fas fa-chart-bar"></i>إحصائيات العائلة</h5>
                </div>
                <div class="card-body">
                    <div class="stat-item d-flex justify-content-between align-items-center mb-3">
                        <div class="d-flex align-items-center">
                            <i class="fas fa-users text-gold me-2"></i>
                            <span>إجمالي الأفراد</span>
                        </div>
                        <span class="badge bg-gold text-dark fs-6">123</span>
                    </div>
                    <div class="stat-item d-flex justify-content-between align-items-center mb-3">
                        <div class="d-flex align-items-center">
                            <i class="fas fa-layer-group text-gold me-2"></i>
                            <span>عدد الأجيال</span>
                        </div>
                        <span class="badge bg-gold text-dark fs-6">7</span>
                    </div>
                    <div class="stat-item d-flex justify-content-between align-items-center mb-3">
                        <div class="d-flex align-items-center">
                            <i class="fas fa-map-marker-alt text-gold me-2"></i>
                            <span>المدن والمناطق</span>
                        </div>
                        <span class="badge bg-gold text-dark fs-6">12</span>
                    </div>
                    <div class="stat-item d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center">
                            <i class="fas fa-calendar-alt text-gold me-2"></i>
                            <span>تاريخ التأسيس</span>
                        </div>
                        <span class="badge bg-gold text-dark fs-6">1800م</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- Contact Info -->
        <section class="contact-section mt-4 fade-in-up">
            <div class="card-islamic">
                <div class="card-header">
                    <h5><i class="fas fa-envelope"></i>معلومات التواصل</h5>
                </div>
                <div class="card-body">
                    <div class="contact-item mb-3">
                        <i class="fas fa-phone text-gold me-2"></i>
                        <a href="tel:00963991231134" class="text-decoration-none text-dark">
                            00963991231134
                        </a>
                    </div>
                    <div class="contact-item mb-3">
                        <i class="fas fa-envelope text-gold me-2"></i>
                        <a href="mailto:hamzasukkar@gmail.com" class="text-decoration-none text-dark">
                            hamzasukkar@gmail.com
                        </a>
                    </div>
                    <div class="contact-item">
                        <i class="fas fa-map-marker-alt text-gold me-2"></i>
                        <span>دمشق، سوريا</span>
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>

<!-- Image Gallery Section -->
<section class="gallery-section mt-5 fade-in-up">
    <div class="card-islamic">
        <div class="card-header">
            <h5><i class="fas fa-images"></i>معرض الصور التراثية</h5>
        </div>
        <div class="card-body">
            <div class="row">
                @for (int i = 1; i <= 6; i++)
                {
                    <div class="col-md-2 col-sm-4 col-6 mb-3">
                        <div class="gallery-item">
                            <img src="~/img/@($"slide{i}.jpg")" alt="صورة تراثية @i" class="img-fluid rounded shadow" style="aspect-ratio: 1; object-fit: cover;">
                            <div class="gallery-overlay">
                                <i class="fas fa-search-plus"></i>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Add smooth scrolling
            document.querySelectorAll('a[href^="#"]').forEach(anchor => {
                anchor.addEventListener('click', function (e) {
                    e.preventDefault();
                    document.querySelector(this.getAttribute('href')).scrollIntoView({
                        behavior: 'smooth'
                    });
                });
            });

            // Add loading animation to images
            const images = document.querySelectorAll('img');
            images.forEach(img => {
                img.addEventListener('load', function() {
                    this.classList.add('loaded');
                });
            });

            // Add gallery functionality
            const galleryItems = document.querySelectorAll('.gallery-item');
            galleryItems.forEach(item => {
                item.addEventListener('click', function() {
                    const img = this.querySelector('img');
                    // Here you could implement a lightbox or modal gallery
                    console.log('Gallery item clicked:', img.src);
                });
            });
        });
    </script>
    
    <style>
        .bg-gold {
            background-color: var(--islamic-gold) !important;
        }
        
        .gallery-item {
            position: relative;
            cursor: pointer;
            overflow: hidden;
            border-radius: 8px;
            transition: transform 0.3s ease;
        }
        
        .gallery-item:hover {
            transform: scale(1.05);
        }
        
        .gallery-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(26, 71, 42, 0.8);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            opacity: 0;
            transition: opacity 0.3s ease;
        }
        
        .gallery-item:hover .gallery-overlay {
            opacity: 1;
        }
        
        img {
            opacity: 0;
            transition: opacity 0.5s ease;
        }
        
        img.loaded {
            opacity: 1;
        }
        
        .heritage-image-container {
            position: relative;
        }
        
        .islamic-pattern-overlay {
            position: absolute;
            top: -10px;
            left: -10px;
            right: -10px;
            bottom: -10px;
            border: 2px solid var(--islamic-gold);
            border-radius: 50%;
            opacity: 0.3;
            animation: pulse 2s infinite;
        }
        
        @@keyframes pulse {
            0% { transform: scale(1); opacity: 0.3; }
            50% { transform: scale(1.05); opacity: 0.6; }
            100% { transform: scale(1); opacity: 0.3; }
        }
    </style>
}