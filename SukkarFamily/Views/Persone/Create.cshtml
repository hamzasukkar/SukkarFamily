@model SukkarFamily.Models.Persone
@{
    ViewData["Title"] = "إضافة فرد جديد";
    Layout = "~/Views/Shared/_LayoutArabic.cshtml";
}

<div class="create-member-page">
    <!-- Page Header -->
    <div class="page-header fade-in-up">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h1 class="arabic-title">
                    <i class="fas fa-user-plus text-gold me-3"></i>
                    إضافة فرد جديد لعائلة سكر
                </h1>
                <p class="lead text-muted">
                    @if (ViewBag.GetParents != null && ((List<SukkarFamily.Models.Persone>)ViewBag.GetParents).Count == 1)
                    {
                        var parent = ((List<SukkarFamily.Models.Persone>)ViewBag.GetParents).First();
                        <span>إضافة طفل جديد للوالد: <strong class="text-gold">@parent.name</strong></span>
                    }
                    else
                    {
                        <span>أضف عضواً جديداً إلى شجرة العائلة</span>
                    }
                </p>
            </div>
            <div class="col-md-4 text-md-end">
                <a href="@Url.Action("Index", "Persone")" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left me-2"></i>العودة للقائمة
                </a>
            </div>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-xl-8 col-lg-10">
            <div class="create-form-container fade-in-up">
                <div class="card-islamic">
                    <div class="card-header">
                        <h5 class="mb-0">
                            <i class="fas fa-user-edit me-2"></i>
                            معلومات الفرد الجديد
                        </h5>
                    </div>
                    <div class="card-body">
                        <form asp-action="Create" method="post" id="createPersonForm">
                            <div asp-validation-summary="ModelOnly" class="alert alert-islamic-error" role="alert"></div>
                            
                            <!-- Personal Information Section -->
                            <div class="form-section">
                                <h6 class="section-title">
                                    <i class="fas fa-id-card text-gold me-2"></i>
                                    المعلومات الشخصية
                                </h6>
                                
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group mb-3">
                                            <label asp-for="name" class="form-label required">
                                                <i class="fas fa-user me-2 text-gold"></i>الاسم الكامل
                                            </label>
                                            <input asp-for="name" class="form-control arabic-input" placeholder="أدخل الاسم الكامل بالعربية" required>
                                            <span asp-validation-for="name" class="text-danger"></span>
                                            <div class="form-text">يُفضل كتابة الاسم باللغة العربية</div>
                                        </div>
                                    </div>
                                    
                                    <div class="col-md-6">
                                        <div class="form-group mb-3">
                                            <label asp-for="title" class="form-label">
                                                <i class="fas fa-crown me-2 text-gold"></i>اللقب أو الكنية
                                            </label>
                                            <input asp-for="title" class="form-control arabic-input" placeholder="مثال: أبو محمد، الشيخ، الدكتور">
                                            <span asp-validation-for="title" class="text-danger"></span>
                                            <div class="form-text">اللقب أو الكنية المعروف بها (اختياري)</div>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group mb-3">
                                            <label asp-for="Country" class="form-label">
                                                <i class="fas fa-globe me-2 text-gold"></i>البلد
                                            </label>
                                            <input asp-for="Country" class="form-control arabic-input" placeholder="مثال: المملكة العربية السعودية، الإمارات العربية المتحدة">
                                            <span asp-validation-for="Country" class="text-danger"></span>
                                            <div class="form-text">البلد الذي يقيم فيه الفرد (اختياري)</div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <!-- Empty column for spacing -->
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-12">
                                        <div class="form-group mb-3">
                                            <label asp-for="image" class="form-label">
                                                <i class="fas fa-image me-2 text-gold"></i>رابط الصورة الشخصية
                                            </label>
                                            <div class="input-group">
                                                <input asp-for="image" class="form-control" placeholder="https://example.com/image.jpg" id="imageInput">
                                                <button type="button" class="btn btn-outline-secondary" id="previewBtn">
                                                    <i class="fas fa-eye"></i> معاينة
                                                </button>
                                            </div>
                                            <span asp-validation-for="image" class="text-danger"></span>
                                            <div class="form-text">رابط صورة شخصية (اختياري)</div>
                                        </div>
                                        
                                        <!-- Image Preview -->
                                        <div id="imagePreview" class="image-preview d-none">
                                            <img id="previewImg" src="" alt="معاينة الصورة" class="preview-image">
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Creation Mode Section -->
                            <div class="form-section">
                                <h6 class="section-title">
                                    <i class="fas fa-cog text-gold me-2"></i>
                                    نوع الإضافة
                                </h6>
                                
                                <div class="creation-mode-selector mb-4">
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="radio" name="creationMode" id="singleMode" value="single" checked>
                                        <label class="form-check-label" for="singleMode">
                                            <i class="fas fa-user me-2"></i>إضافة فرد واحد
                                        </label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="radio" name="creationMode" id="multipleMode" value="multiple">
                                        <label class="form-check-label" for="multipleMode">
                                            <i class="fas fa-users me-2"></i>إضافة أطفال متعددين
                                        </label>
                                    </div>
                                </div>
                            </div>

                            <!-- Single Person Section -->
                            <div id="singlePersonSection" class="form-section">
                                <h6 class="section-title">
                                    <i class="fas fa-user-edit text-gold me-2"></i>
                                    معلومات الفرد
                                </h6>
                                
                                <div class="single-person-form">
                                    <!-- This will contain the original single person form -->
                                </div>
                            </div>

                            <!-- Multiple Children Section -->
                            <div id="multipleChildrenSection" class="form-section d-none">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h6 class="section-title mb-0">
                                        <i class="fas fa-baby text-gold me-2"></i>
                                        معلومات الأطفال
                                    </h6>
                                    <div class="children-controls">
                                        <button type="button" id="addChildBtn" class="btn btn-sm btn-outline-primary">
                                            <i class="fas fa-plus me-1"></i>إضافة طفل
                                        </button>
                                        <button type="button" id="removeChildBtn" class="btn btn-sm btn-outline-danger">
                                            <i class="fas fa-minus me-1"></i>إزالة آخر طفل
                                        </button>
                                    </div>
                                </div>
                                
                                <div id="childrenContainer">
                                    <!-- Children forms will be added dynamically -->
                                </div>
                            </div>

                            <!-- Family Relations Section -->
                            <div class="form-section">
                                <h6 class="section-title">
                                    <i class="fas fa-sitemap text-gold me-2"></i>
                                    العلاقات العائلية
                                </h6>
                                
                                @if (ViewBag.GetParents != null && ((List<SukkarFamily.Models.Persone>)ViewBag.GetParents).Any())
                                {
                                    var parents = (List<SukkarFamily.Models.Persone>)ViewBag.GetParents;
                                    var maxGeneration = parents.Max(p => p.Generation);
                                    
                                    <!-- Generation Filter for Parent Selection -->
                                    <div class="form-group mb-3">
                                        <label class="form-label">
                                            <i class="fas fa-layer-group me-2 text-gold"></i>تصفية الأجيال
                                        </label>
                                        <select id="generationFilter" class="form-select">
                                            <option value="">جميع الأجيال</option>
                                            @for (int gen = 1; gen <= maxGeneration; gen++)
                                            {
                                                <option value="@gen">الجيل @gen (@parents.Count(p => p.Generation == gen) أشخاص)</option>
                                            }
                                        </select>
                                        <div class="form-text">قم بتصفية الوالدين المحتملين حسب الجيل</div>
                                    </div>

                                    <div class="form-group mb-3">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <label asp-for="Parent" class="form-label mb-0">
                                                <i class="fas fa-user-tie me-2 text-gold"></i>الوالد
                                            </label>
                                            <div class="parent-selection-toggle">
                                                <div class="btn-group btn-group-sm" role="group">
                                                    <input type="radio" class="btn-check" name="parentSelectionMode" id="dropdownMode" value="dropdown" checked>
                                                    <label class="btn btn-outline-secondary" for="dropdownMode">
                                                        <i class="fas fa-list me-1"></i>قائمة
                                                    </label>

                                                    <input type="radio" class="btn-check" name="parentSelectionMode" id="treeMode" value="tree">
                                                    <label class="btn btn-outline-secondary" for="treeMode">
                                                        <i class="fas fa-sitemap me-1"></i>شجرة
                                                    </label>
                                                </div>
                                            </div>
                                        </div>
                                        
                                        <!-- Dropdown Selection Mode -->
                                        <div id="dropdownSelectionContainer">
                                            @if (parents.Count == 1)
                                            {
                                                var parent = parents.First();
                                                <div class="selected-parent-card">
                                                    <div class="parent-info">
                                                        <div class="parent-avatar">
                                                            @if (!string.IsNullOrEmpty(parent.image))
                                                            {
                                                                <img src="@parent.image" alt="@parent.name">
                                                            }
                                                            else
                                                            {
                                                                <i class="fas fa-user"></i>
                                                            }
                                                        </div>
                                                        <div class="parent-details">
                                                            <h6>
                                                                @parent.name
                                                                @if (parent.Parent != null)
                                                                {
                                                                    <span> ابن/ابنة @parent.Parent.name</span>
                                                                }
                                                                else
                                                                {
                                                                    <span> (الجد الأعلى)</span>
                                                                }
                                                            </h6>
                                                            <p class="mb-0">
                                                                @(parent.title ?? "بدون لقب") - الجيل @parent.Generation
                                                                @if (parent.Parent != null)
                                                                {
                                                                    <span class="ms-2"><i class="fas fa-arrow-up text-muted"></i> الوالد: @parent.Parent.name</span>
                                                                }
                                                            </p>
                                                        </div>
                                                    </div>
                                                    @Html.DropDownListFor(m => m.Parent, new SelectList(parents, "Id", "name"), new { @class = "d-none" })
                                                </div>
                                            }
                                            else
                                            {
                                                <!-- Search input for parent selection -->
                                                <div class="parent-search-container">
                                                    <div class="input-group">
                                                        <span class="input-group-text">
                                                            <i class="fas fa-search text-gold"></i>
                                                        </span>
                                                        <input type="text" id="parentSearchInput" class="form-control" placeholder="ابحث عن الوالد بالاسم...">
                                                        <button type="button" id="clearSearchBtn" class="btn btn-outline-secondary">
                                                            <i class="fas fa-times"></i>
                                                        </button>
                                                    </div>
                                                    <div class="form-text">ابدأ بالكتابة للبحث عن الوالد</div>
                                                </div>

                                                <select name="Parent" id="parentSelect" class="form-select" style="margin-top: 10px;">
                                                    <option value="">اختر الوالد</option>
                                                    @foreach(var parent in parents.OrderBy(p => p.Generation).ThenBy(p => p.name))
                                                    {
                                                        var parentText = parent.name;
                                                        if (parent.Parent != null)
                                                        {
                                                            parentText += " ابن/ابنة " + parent.Parent.name;
                                                        }
                                                        else
                                                        {
                                                            parentText += " (الجد الأعلى)";
                                                        }
                                                        parentText += " - الجيل " + parent.Generation;

                                                        <option value="@parent.Id"
                                                                data-generation="@parent.Generation"
                                                                data-name="@parent.name"
                                                                data-title="@(parent.title ?? "")"
                                                                data-country="@(parent.Country ?? "")"
                                                                data-image="@(parent.image ?? "")"
                                                                data-parent-name="@(parent.Parent?.name ?? "")"
                                                                data-search-text="@parentText.ToLower()">
                                                            @parentText
                                                        </option>
                                                    }
                                                </select>
                                            }
                                        </div>

                                        <!-- Tree Selection Mode -->
                                        <div id="treeSelectionContainer" class="d-none">
                                            <div class="family-tree-selector">
                                                <div class="tree-header">
                                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                                        <span class="tree-title">
                                                            <i class="fas fa-sitemap text-gold me-2"></i>اختر الوالد من الشجرة
                                                        </span>
                                                        <button type="button" id="expandAllTreeBtn" class="btn btn-sm btn-outline-secondary">
                                                            <i class="fas fa-expand-arrows-alt me-1"></i>توسيع الكل
                                                        </button>
                                                    </div>
                                                </div>

                                                <div id="familyTreeContainer" class="family-tree-container">
                                                    <!-- Tree will be generated by JavaScript -->
                                                </div>

                                                <div class="form-text mt-2">انقر على أي شخص في الشجرة لاختياره كوالد</div>
                                            </div>
                                        </div>

                                        <!-- Hidden input to store selected parent from tree -->
                                        <input type="hidden" id="selectedParentFromTree" name="Parent" />
                                        <span asp-validation-for="Parent" class="text-danger"></span>
                                        <div class="form-text">اختر الوالد من القائمة (اختياري للشخص الأول)</div>
                                    </div>

                                    <!-- Selected Parent Preview -->
                                    <div id="selectedParentPreview" class="selected-parent-preview d-none">
                                        <div class="preview-card">
                                            <div class="preview-header">
                                                <i class="fas fa-user-check text-success me-2"></i>
                                                <strong>الوالد المختار</strong>
                                            </div>
                                            <div class="preview-content">
                                                <div class="preview-avatar">
                                                    <img id="previewImage" src="" alt="" style="display: none;">
                                                    <i id="previewIcon" class="fas fa-user"></i>
                                                </div>
                                                <div class="preview-details">
                                                    <h6 id="previewName"></h6>
                                                    <p id="previewInfo" class="mb-1"></p>
                                                    <span id="previewGeneration" class="generation-badge"></span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="generation-info-card">
                                        <div class="info-content">
                                            <i class="fas fa-info-circle text-primary me-2"></i>
                                            <span>
                                                @if (parents.Count == 1)
                                                {
                                                    <span>سيتم تعيين هذا الفرد في الجيل <strong>@(parents.First().Generation + 1)</strong> تلقائياً</span>
                                                }
                                                else
                                                {
                                                    <span>سيتم تحديد الجيل تلقائياً بناءً على الوالد المختار</span>
                                                }
                                            </span>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <!-- No existing family members - Root person creation -->
                                    <div class="root-person-info-card">
                                        <div class="info-content">
                                            <i class="fas fa-crown text-gold me-3" style="font-size: 2rem;"></i>
                                            <div>
                                                <h6 class="text-gold mb-2">إنشاء الجد الأعلى للعائلة</h6>
                                                <p class="mb-0 text-muted">
                                                    هذا هو أول شخص يتم إضافته لشجرة العائلة وسيصبح الجد الأعلى.
                                                    سيتم تعيينه في الجيل الأول تلقائياً.
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <!-- Hidden input to indicate this is a root person -->
                                    <input type="hidden" name="IsRootPerson" value="true" />
                                }
                            </div>

                            <!-- Submit Section -->
                            <div class="form-section">
                                <div class="submit-actions">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <button type="submit" class="btn btn-gold btn-lg w-100" id="submitBtn">
                                                <i class="fas fa-save me-2"></i>إضافة الفرد
                                            </button>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="btn-group w-100">
                                                <button type="button" class="btn btn-outline-secondary btn-lg" onclick="resetForm()">
                                                    <i class="fas fa-redo me-2"></i>إعادة تعيين
                                                </button>
                                                <a href="@Url.Action("Index", "Persone")" class="btn btn-outline-danger btn-lg">
                                                    <i class="fas fa-times me-2"></i>إلغاء
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <!-- Family Tree Data for JavaScript -->
    <script>
        @{
            var treeData = new List<object>();
            if (ViewBag.GetParents != null)
            {
                var parents = (List<SukkarFamily.Models.Persone>)ViewBag.GetParents;

                // Debug: Log each person being processed
                foreach(var p in parents)
                {
                    System.Diagnostics.Debug.WriteLine($"Processing person: Id={p.Id}, Name={p.name}, Title={p.title}, Generation={p.Generation}, ParentId={p.Parent?.Id}");
                }

                treeData = parents
                    .OrderBy(p => p.Generation)
                    .ThenBy(p => p.name)
                    .Select(p => new {
                        Id = p.Id,
                        name = p.name ?? "",
                        title = p.title ?? "",
                        Country = p.Country ?? "",
                        image = p.image ?? "",
                        Generation = p.Generation,
                        Parent = p.Parent?.Id // Only store the parent ID, not the full object
                    }).ToList<object>();
            }
        }
        window.familyTreeData = @Html.Raw(Json.Serialize(treeData));

        // Debug: Log the serialized data
        console.log('Serialized Family Tree Data:', window.familyTreeData);
    </script>
    
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            initializeForm();
            setupImagePreview();
            setupArabicInputs();
            setupFormValidation();
            setupCreationModeToggle();
            setupMultipleChildrenFunctionality();
            setupGenerationFilter();
            setupParentPreview();
            setupParentSearch();
            setupParentSelectionToggle();
            setupFamilyTree();
        });

        function initializeForm() {
            // Focus on first input
            const nameInput = document.querySelector('input[name="name"]');
            if (nameInput) {
                nameInput.focus();
            }

            // Add loading state to submit button
            const form = document.getElementById('createPersonForm');
            const submitBtn = document.getElementById('submitBtn');
            
            form.addEventListener('submit', function() {
                submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>جاري الإضافة...';
                submitBtn.disabled = true;
            });
        }

        function setupImagePreview() {
            const imageInput = document.getElementById('imageInput');
            const previewBtn = document.getElementById('previewBtn');
            const imagePreview = document.getElementById('imagePreview');
            const previewImg = document.getElementById('previewImg');

            previewBtn.addEventListener('click', function() {
                const imageUrl = imageInput.value.trim();
                
                if (imageUrl) {
                    previewImg.src = imageUrl;
                    previewImg.onload = function() {
                        imagePreview.classList.remove('d-none');
                        IslamicSite.showToast('تم تحميل الصورة بنجاح', 'success');
                    };
                    previewImg.onerror = function() {
                        IslamicSite.showToast('فشل في تحميل الصورة. تأكد من صحة الرابط', 'error');
                    };
                } else {
                    imagePreview.classList.add('d-none');
                }
            });

            // Auto preview on input change
            imageInput.addEventListener('blur', function() {
                if (this.value.trim()) {
                    previewBtn.click();
                }
            });
        }

        function setupArabicInputs() {
            const arabicInputs = document.querySelectorAll('.arabic-input');
            
            arabicInputs.forEach(input => {
                input.addEventListener('input', function() {
                    const arabicPattern = /[\u0600-\u06FF]/;
                    if (arabicPattern.test(this.value)) {
                        this.style.direction = 'rtl';
                        this.style.textAlign = 'right';
                        this.classList.add('arabic-text');
                    } else if (this.value.trim() === '') {
                        this.style.direction = 'rtl';
                        this.style.textAlign = 'right';
                    }
                });

                // Set initial RTL direction
                input.style.direction = 'rtl';
                input.style.textAlign = 'right';
            });
        }

        function setupFormValidation() {
            const form = document.getElementById('createPersonForm');
            
            form.addEventListener('submit', function(e) {
                if (!validateForm()) {
                    e.preventDefault();
                    IslamicSite.showToast('يرجى تصحيح الأخطاء في النموذج', 'error');
                }
            });
        }

        function validateForm() {
            let isValid = true;
            
            // Validate name (required and should be Arabic)
            const nameInput = document.querySelector('input[name="name"]');
            const arabicPattern = /[\u0600-\u06FF]/;
            
            if (!nameInput.value.trim()) {
                showFieldError(nameInput, 'الاسم مطلوب');
                isValid = false;
            } else if (!arabicPattern.test(nameInput.value)) {
                showFieldError(nameInput, 'يُفضل كتابة الاسم بالعربية');
            } else {
                clearFieldError(nameInput);
            }

            // Validate parent selection (optional for root person)
            const parentSelect = document.querySelector('select[name="Parent"]');
            const isRootPerson = document.querySelector('input[name="IsRootPerson"]');
            
            if (parentSelect && !parentSelect.value && !isRootPerson) {
                showFieldError(parentSelect, 'يجب اختيار الوالد');
                isValid = false;
            } else if (parentSelect) {
                clearFieldError(parentSelect);
            }

            return isValid;
        }

        function showFieldError(field, message) {
            field.classList.add('is-invalid');
            
            let errorElement = field.parentNode.querySelector('.invalid-feedback');
            if (!errorElement) {
                errorElement = document.createElement('div');
                errorElement.className = 'invalid-feedback';
                field.parentNode.appendChild(errorElement);
            }
            errorElement.textContent = message;
        }

        function clearFieldError(field) {
            field.classList.remove('is-invalid');
            const errorElement = field.parentNode.querySelector('.invalid-feedback');
            if (errorElement) {
                errorElement.remove();
            }
        }

        function resetForm() {
            document.getElementById('createPersonForm').reset();
            document.getElementById('imagePreview').classList.add('d-none');
            
            // Clear any validation errors
            document.querySelectorAll('.is-invalid').forEach(el => {
                el.classList.remove('is-invalid');
            });
            document.querySelectorAll('.invalid-feedback').forEach(el => {
                el.remove();
            });
            
            IslamicSite.showToast('تم إعادة تعيين النموذج', 'info');
        }

        // Parent selection change handler
        const parentSelect = document.querySelector('select[name="Parent"]');
        if (parentSelect) {
            parentSelect.addEventListener('change', function() {
                const selectedOption = this.options[this.selectedIndex];
                if (selectedOption.value) {
                    // You could fetch and display parent details here
                    console.log('تم اختيار الوالد:', selectedOption.text);
                }
            });
        }

        // Creation Mode Toggle
        function setupCreationModeToggle() {
            const singleModeRadio = document.getElementById('singleMode');
            const multipleModeRadio = document.getElementById('multipleMode');
            const singleSection = document.getElementById('singlePersonSection');
            const multipleSection = document.getElementById('multipleChildrenSection');

            singleModeRadio.addEventListener('change', function() {
                if (this.checked) {
                    singleSection.classList.remove('d-none');
                    multipleSection.classList.add('d-none');
                    // Clear multiple children data
                    document.getElementById('childrenContainer').innerHTML = '';
                }
            });

            multipleModeRadio.addEventListener('change', function() {
                if (this.checked) {
                    singleSection.classList.add('d-none');
                    multipleSection.classList.remove('d-none');
                    // Clear single person data
                    const singleInputs = singleSection.querySelectorAll('input:not([type="hidden"])');
                    singleInputs.forEach(input => input.value = '');
                    // Initialize with first child
                    if (document.getElementById('childrenContainer').children.length === 0) {
                        addChild();
                    }
                }
            });
        }

        // Multiple Children Functionality
        let childCounter = 0;

        function setupMultipleChildrenFunctionality() {
            document.getElementById('addChildBtn').addEventListener('click', addChild);
            document.getElementById('removeChildBtn').addEventListener('click', removeLastChild);
        }

        function addChild() {
            const container = document.getElementById('childrenContainer');
            const childDiv = document.createElement('div');
            childDiv.className = 'child-form-group';
            childDiv.setAttribute('data-child-index', childCounter);
            
            childDiv.innerHTML = `
                <div class="child-header">
                    <h6 class="child-title">
                        <i class="fas fa-child text-gold me-2"></i>الطفل رقم <span class="child-number">${childCounter + 1}</span>
                    </h6>
                    <button type="button" class="btn btn-sm btn-outline-danger remove-child-btn" onclick="removeChild(this)">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
                
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label class="form-label required">
                                <i class="fas fa-user me-2 text-gold"></i>الاسم الكامل
                            </label>
                            <input name="ChildNames" class="form-control arabic-input" placeholder="أدخل اسم الطفل" required>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label class="form-label">
                                <i class="fas fa-crown me-2 text-gold"></i>اللقب أو الكنية
                            </label>
                            <input name="ChildTitles" class="form-control arabic-input" placeholder="مثال: أبو أحمد">
                        </div>
                    </div>
                </div>
                
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label class="form-label">
                                <i class="fas fa-globe me-2 text-gold"></i>البلد
                            </label>
                            <input name="ChildCountries" class="form-control arabic-input" placeholder="البلد">
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label class="form-label">
                                <i class="fas fa-image me-2 text-gold"></i>رابط الصورة
                            </label>
                            <input name="ChildImages" class="form-control" placeholder="https://example.com/image.jpg">
                        </div>
                    </div>
                </div>
            `;
            
            container.appendChild(childDiv);
            childCounter++;
            updateChildNumbers();
            
            // Setup Arabic inputs for new child
            setupArabicInputsForElement(childDiv);
            
            // Focus on name input
            const nameInput = childDiv.querySelector('input[name="ChildNames"]');
            if (nameInput) nameInput.focus();
        }

        function removeChild(button) {
            const childDiv = button.closest('.child-form-group');
            if (document.querySelectorAll('.child-form-group').length > 1) {
                childDiv.remove();
                updateChildNumbers();
            } else {
                alert('يجب أن يكون هناك طفل واحد على الأقل');
            }
        }

        function removeLastChild() {
            const children = document.querySelectorAll('.child-form-group');
            if (children.length > 1) {
                children[children.length - 1].remove();
                updateChildNumbers();
            } else {
                alert('يجب أن يكون هناك طفل واحد على الأقل');
            }
        }

        function updateChildNumbers() {
            const children = document.querySelectorAll('.child-form-group');
            children.forEach((child, index) => {
                const numberSpan = child.querySelector('.child-number');
                if (numberSpan) {
                    numberSpan.textContent = index + 1;
                }
                child.setAttribute('data-child-index', index);
            });
        }

        function setupArabicInputsForElement(element) {
            const arabicInputs = element.querySelectorAll('.arabic-input');
            
            arabicInputs.forEach(input => {
                input.addEventListener('input', function() {
                    const arabicPattern = /[\u0600-\u06FF]/;
                    if (arabicPattern.test(this.value)) {
                        this.style.direction = 'rtl';
                        this.style.textAlign = 'right';
                        this.classList.add('arabic-text');
                    } else if (this.value.trim() === '') {
                        this.style.direction = 'rtl';
                        this.style.textAlign = 'right';
                    }
                });

                // Set initial RTL direction
                input.style.direction = 'rtl';
                input.style.textAlign = 'right';
            });
        }

        // Generation Filter Functionality
        function setupGenerationFilter() {
            const generationFilter = document.getElementById('generationFilter');
            const parentSelect = document.getElementById('parentSelect');
            const searchInput = document.getElementById('parentSearchInput');

            if (!generationFilter || !parentSelect) return;

            generationFilter.addEventListener('change', function() {
                const selectedGeneration = this.value;

                // Clear search when generation filter changes
                if (searchInput) {
                    searchInput.value = '';
                }

                // Apply both generation and search filters
                applyFilters();

                // Reset parent selection if current selection is hidden
                if (selectedGeneration && parentSelect.value) {
                    const currentOption = parentSelect.querySelector(`option[value="${parentSelect.value}"]`);
                    if (currentOption && currentOption.dataset.generation !== selectedGeneration) {
                        parentSelect.value = '';
                        hideParentPreview();
                    }
                }
            });
        }

        // Combined filter function for generation and search
        function applyFilters() {
            const generationFilter = document.getElementById('generationFilter');
            const searchInput = document.getElementById('parentSearchInput');
            const parentSelect = document.getElementById('parentSelect');

            if (!parentSelect) return;

            const selectedGeneration = generationFilter ? generationFilter.value : '';
            const searchTerm = searchInput ? searchInput.value.trim().toLowerCase() : '';

            // Get original options (stored during setup)
            const originalOptions = window.originalParentOptions || Array.from(parentSelect.options);

            // Clear current options
            parentSelect.innerHTML = '';

            // Add default option
            const defaultOption = originalOptions[0].cloneNode(true);
            parentSelect.appendChild(defaultOption);

            // Filter options
            const filteredOptions = originalOptions.slice(1).filter(option => {
                const generation = option.dataset.generation;
                const searchText = option.dataset.searchText || option.textContent.toLowerCase();
                const name = option.dataset.name ? option.dataset.name.toLowerCase() : '';
                const parentName = option.dataset.parentName ? option.dataset.parentName.toLowerCase() : '';

                // Check generation filter
                const generationMatch = !selectedGeneration || generation === selectedGeneration;

                // Check search filter
                const searchMatch = !searchTerm ||
                    searchText.includes(searchTerm) ||
                    name.includes(searchTerm) ||
                    parentName.includes(searchTerm);

                return generationMatch && searchMatch;
            });

            // Add filtered options
            filteredOptions.forEach(option => {
                parentSelect.appendChild(option.cloneNode(true));
            });

            // Update placeholder text
            let placeholderText = 'اختر الوالد';
            if (selectedGeneration && searchTerm) {
                placeholderText = `اختر من ${filteredOptions.length} نتيجة في الجيل ${selectedGeneration}`;
            } else if (selectedGeneration) {
                placeholderText = `اختر الوالد من الجيل ${selectedGeneration}`;
            } else if (searchTerm) {
                placeholderText = `اختر من ${filteredOptions.length} نتيجة`;
            }

            if (filteredOptions.length === 0) {
                placeholderText = 'لا توجد نتائج';
            }

            defaultOption.textContent = placeholderText;

            // Reset selection if current selection is not visible
            if (parentSelect.value && !Array.from(parentSelect.options).some(opt => opt.value === parentSelect.value)) {
                parentSelect.value = '';
                hideParentPreview();
            }
        }

        // Parent Preview Functionality
        function setupParentPreview() {
            const parentSelect = document.getElementById('parentSelect');
            if (!parentSelect) return;

            parentSelect.addEventListener('change', function() {
                const selectedOption = this.options[this.selectedIndex];
                
                if (selectedOption.value) {
                    showParentPreview(selectedOption);
                } else {
                    hideParentPreview();
                }
            });
        }

        function showParentPreview(option) {
            const preview = document.getElementById('selectedParentPreview');
            const previewImage = document.getElementById('previewImage');
            const previewIcon = document.getElementById('previewIcon');
            const previewName = document.getElementById('previewName');
            const previewInfo = document.getElementById('previewInfo');
            const previewGeneration = document.getElementById('previewGeneration');
            
            // Set parent details
            const name = option.dataset.name;
            const title = option.dataset.title;
            const country = option.dataset.country;
            const image = option.dataset.image;
            const generation = option.dataset.generation;
            const parentName = option.dataset.parentName;
            
            // Build parent name with hierarchy
            let displayName = name;
            if (parentName && parentName.trim() !== '') {
                displayName += ` ابن/ابنة ${parentName}`;
            } else {
                displayName += ' (الجد الأعلى)';
            }
            previewName.textContent = displayName;
            
            // Build info string
            let info = [];
            if (title) info.push(`اللقب: ${title}`);
            if (country) info.push(`البلد: ${country}`);
            if (parentName && parentName.trim() !== '') {
                info.push(`الوالد: ${parentName}`);
            }
            previewInfo.textContent = info.length > 0 ? info.join(' • ') : 'لا توجد معلومات إضافية';
            
            // Handle image/icon
            if (image && image.trim() !== '') {
                previewImage.src = image;
                previewImage.style.display = '';
                previewIcon.style.display = 'none';
            } else {
                previewImage.style.display = 'none';
                previewIcon.style.display = '';
            }
            
            // Set generation badge
            previewGeneration.textContent = `الجيل ${generation}`;
            previewGeneration.className = `generation-badge generation-${generation}`;
            
            // Show preview
            preview.classList.remove('d-none');
        }

        function hideParentPreview() {
            const preview = document.getElementById('selectedParentPreview');
            if (preview) {
                preview.classList.add('d-none');
            }
        }

        // Parent Search Functionality
        function setupParentSearch() {
            const searchInput = document.getElementById('parentSearchInput');
            const clearBtn = document.getElementById('clearSearchBtn');
            const parentSelect = document.getElementById('parentSelect');

            if (!searchInput || !parentSelect) return;

            // Store original options globally for use by applyFilters
            window.originalParentOptions = Array.from(parentSelect.options);

            searchInput.addEventListener('input', function() {
                applyFilters();
            });

            if (clearBtn) {
                clearBtn.addEventListener('click', function() {
                    searchInput.value = '';
                    applyFilters();
                    searchInput.focus();
                });
            }

            // Clear search when parent is selected
            parentSelect.addEventListener('change', function() {
                if (this.value) {
                    searchInput.value = '';
                }
            });
        }

        // Parent Selection Mode Toggle
        function setupParentSelectionToggle() {
            const dropdownMode = document.getElementById('dropdownMode');
            const treeMode = document.getElementById('treeMode');
            const dropdownContainer = document.getElementById('dropdownSelectionContainer');
            const treeContainer = document.getElementById('treeSelectionContainer');

            if (!dropdownMode || !treeMode) return;

            dropdownMode.addEventListener('change', function() {
                if (this.checked) {
                    dropdownContainer.classList.remove('d-none');
                    treeContainer.classList.add('d-none');
                    // Clear tree selection
                    clearTreeSelection();
                }
            });

            treeMode.addEventListener('change', function() {
                if (this.checked) {
                    dropdownContainer.classList.add('d-none');
                    treeContainer.classList.remove('d-none');
                    // Clear dropdown selection
                    clearDropdownSelection();
                    // Build tree if not already built
                    if (!window.treeBuilt) {
                        buildFamilyTree();
                    }
                }
            });
        }

        // Family Tree Functionality
        function setupFamilyTree() {
            const expandAllBtn = document.getElementById('expandAllTreeBtn');

            if (expandAllBtn) {
                expandAllBtn.addEventListener('click', function() {
                    toggleAllTreeNodes();
                });
            }
        }

        function buildFamilyTree() {
            const container = document.getElementById('familyTreeContainer');
            if (!container || !window.familyTreeData) return;

            const treeData = window.familyTreeData;
            if (!treeData || treeData.length === 0) {
                container.innerHTML = '<div class="text-center text-muted py-4"><i class="fas fa-info-circle me-2"></i>لا توجد أفراد في العائلة حالياً</div>';
                return;
            }

            // Debug: Log the tree data to console
            console.log('Family Tree Data:', treeData);

            // Build tree structure
            const treeStructure = buildTreeStructure(treeData);
            console.log('Tree Structure:', treeStructure);

            const treeHTML = renderTree(treeStructure);

            container.innerHTML = treeHTML;
            window.treeBuilt = true;

            // Setup click handlers
            setupTreeClickHandlers();
        }

        function buildTreeStructure(data) {
            // Create a completely new structure to avoid any reference issues
            const nodeMap = new Map();
            const roots = [];

            // First pass: create all nodes
            for (let i = 0; i < data.length; i++) {
                const person = data[i];
                const node = createPersonNode(person);
                nodeMap.set(person.Id, node);

                console.log(`Created node ${i}: ID=${person.Id}, Name="${person.name}" -> Node Name="${node.name}"`);
            }

            // Second pass: build hierarchy
            for (let i = 0; i < data.length; i++) {
                const person = data[i];
                const currentNode = nodeMap.get(person.Id);

                console.log(`Building hierarchy for: ID=${person.Id}, Name="${currentNode.name}", ParentID=${person.Parent}`);

                if (person.Parent && nodeMap.has(person.Parent)) {
                    const parentNode = nodeMap.get(person.Parent);
                    parentNode.children.push(currentNode);
                    console.log(`Added ${currentNode.name} as child of ${parentNode.name}`);
                } else {
                    roots.push(currentNode);
                    console.log(`Added ${currentNode.name} as root`);
                }
            }

            return roots;
        }

        function createPersonNode(person) {
            return {
                Id: person.Id,
                name: person.name,
                title: person.title,
                Country: person.Country,
                image: person.image,
                Generation: person.Generation,
                Parent: person.Parent,
                children: []
            };
        }

        function renderTree(nodes, level = 0) {
            if (!nodes || nodes.length === 0) return '';

            // Sort nodes by Generation, then by name for consistent display
            const sortedNodes = [...nodes].sort((a, b) => {
                if (a.Generation !== b.Generation) {
                    return a.Generation - b.Generation;
                }
                return (a.name || '').localeCompare(b.name || '', 'ar', {numeric: true});
            });

            let html = '<ul class="tree-level tree-level-' + level + '">';

            sortedNodes.forEach(node => {
                const hasChildren = node.children && node.children.length > 0;
                const nodeClass = 'tree-node' + (hasChildren ? ' has-children' : '');

                // Debug: Log each node being rendered
                console.log('Rendering node:', {
                    id: node.Id,
                    name: node.name,
                    title: node.title,
                    generation: node.Generation,
                    parent: node.Parent,
                    hasChildren: hasChildren
                });

                html += `
                    <li class="${nodeClass}" data-person-id="${node.Id}">
                        <div class="tree-node-content" data-person-id="${node.Id}">
                            <div class="node-toggle ${hasChildren ? '' : 'invisible'}">
                                <i class="fas fa-chevron-down"></i>
                            </div>
                            <div class="node-avatar">
                                ${node.image ?
                                    `<img src="${node.image}" alt="${node.name}">` :
                                    '<i class="fas fa-user"></i>'
                                }
                            </div>
                            <div class="node-info">
                                <div class="node-name">${node.name}</div>
                                <div class="node-details">
                                    ${node.title || 'بدون لقب'} • الجيل ${node.Generation}
                                </div>
                            </div>
                            <div class="node-select-btn">
                                <i class="fas fa-check-circle"></i>
                            </div>
                        </div>
                        ${hasChildren ? renderTree(node.children, level + 1) : ''}
                    </li>
                `;
            });

            html += '</ul>';
            return html;
        }

        function setupTreeClickHandlers() {
            const container = document.getElementById('familyTreeContainer');

            // Toggle nodes
            container.addEventListener('click', function(e) {
                if (e.target.closest('.node-toggle')) {
                    e.preventDefault();
                    e.stopPropagation();
                    const node = e.target.closest('.tree-node');
                    toggleTreeNode(node);
                }
            });

            // Select parent
            container.addEventListener('click', function(e) {
                const nodeContent = e.target.closest('.tree-node-content');
                if (nodeContent && !e.target.closest('.node-toggle')) {
                    e.preventDefault();
                    e.stopPropagation();
                    const personId = nodeContent.dataset.personId;
                    selectParentFromTree(personId, nodeContent);
                }
            });
        }

        function toggleTreeNode(node) {
            const childList = node.querySelector('ul.tree-level');
            const toggle = node.querySelector('.node-toggle i');

            if (childList) {
                if (childList.style.display === 'none') {
                    childList.style.display = '';
                    toggle.className = 'fas fa-chevron-down';
                    node.classList.remove('collapsed');
                } else {
                    childList.style.display = 'none';
                    toggle.className = 'fas fa-chevron-right';
                    node.classList.add('collapsed');
                }
            }
        }

        function toggleAllTreeNodes() {
            const container = document.getElementById('familyTreeContainer');
            const expandAllBtn = document.getElementById('expandAllTreeBtn');
            const allNodes = container.querySelectorAll('.tree-node.has-children');

            const isExpanded = Array.from(allNodes).some(node =>
                !node.classList.contains('collapsed')
            );

            allNodes.forEach(node => {
                const childList = node.querySelector('ul.tree-level');
                const toggle = node.querySelector('.node-toggle i');

                if (childList) {
                    if (isExpanded) {
                        // Collapse all
                        childList.style.display = 'none';
                        toggle.className = 'fas fa-chevron-right';
                        node.classList.add('collapsed');
                    } else {
                        // Expand all
                        childList.style.display = '';
                        toggle.className = 'fas fa-chevron-down';
                        node.classList.remove('collapsed');
                    }
                }
            });

            // Update button text
            expandAllBtn.innerHTML = isExpanded ?
                '<i class="fas fa-expand-arrows-alt me-1"></i>توسيع الكل' :
                '<i class="fas fa-compress-arrows-alt me-1"></i>طي الكل';
        }

        function selectParentFromTree(personId, nodeElement) {
            // Clear previous selection
            document.querySelectorAll('.tree-node-content.selected').forEach(node => {
                node.classList.remove('selected');
            });

            // Select current node
            nodeElement.classList.add('selected');

            // Update hidden input
            const hiddenInput = document.getElementById('selectedParentFromTree');
            if (hiddenInput) {
                hiddenInput.value = personId;
            }

            // Find person data
            const personData = window.familyTreeData.find(p => p.Id == personId);
            if (personData) {
                // Show selection feedback
                showTreeSelectionFeedback(personData);
            }
        }

        function showTreeSelectionFeedback(person) {
            // Create or update feedback element
            let feedback = document.getElementById('treeSelectionFeedback');
            if (!feedback) {
                feedback = document.createElement('div');
                feedback.id = 'treeSelectionFeedback';
                feedback.className = 'tree-selection-feedback mt-3';
                document.getElementById('treeSelectionContainer').appendChild(feedback);
            }

            const hierarchyText = person.Parent ?
                `ابن/ابنة ${getParentName(person.Parent)}` :
                '(الجد الأعلى)';

            feedback.innerHTML = `
                <div class="selected-parent-card">
                    <div class="parent-info">
                        <div class="parent-avatar">
                            ${person.image ?
                                `<img src="${person.image}" alt="${person.name}">` :
                                '<i class="fas fa-user"></i>'
                            }
                        </div>
                        <div class="parent-details">
                            <h6>
                                ${person.name} ${hierarchyText}
                            </h6>
                            <p class="mb-0">
                                ${person.title || 'بدون لقب'} - الجيل ${person.Generation}
                            </p>
                        </div>
                        <div class="selection-badge">
                            <i class="fas fa-check-circle text-success"></i>
                        </div>
                    </div>
                </div>
            `;
        }

        function getParentName(parentId) {
            const parent = window.familyTreeData.find(p => p.Id == parentId);
            return parent ? parent.name : 'غير معروف';
        }

        function clearTreeSelection() {
            document.querySelectorAll('.tree-node-content.selected').forEach(node => {
                node.classList.remove('selected');
            });

            const hiddenInput = document.getElementById('selectedParentFromTree');
            if (hiddenInput) {
                hiddenInput.value = '';
            }

            const feedback = document.getElementById('treeSelectionFeedback');
            if (feedback) {
                feedback.remove();
            }
        }

        function clearDropdownSelection() {
            const parentSelect = document.getElementById('parentSelect');
            const searchInput = document.getElementById('parentSearchInput');

            if (parentSelect) {
                parentSelect.value = '';
            }
            if (searchInput) {
                searchInput.value = '';
                applyFilters();
            }
            hideParentPreview();
        }
    </script>

