@model SukkarFamily.Models.Persone
@{
    ViewData["Title"] = "إضافة فرد جديد";
    Layout = "~/Views/Shared/_LayoutArabic.cshtml";
}

<div class="create-member-page">
    <!-- Page Header -->
    <div class="page-header fade-in-up">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h1 class="arabic-title">
                    <i class="fas fa-user-plus text-gold me-3"></i>
                    إضافة فرد جديد لعائلة سكر
                </h1>
                <p class="lead text-muted">
                    @if (ViewBag.GetParents != null && ((List<SukkarFamily.Models.Persone>)ViewBag.GetParents).Count == 1)
                    {
                        var parent = ((List<SukkarFamily.Models.Persone>)ViewBag.GetParents).First();
                        <span>إضافة طفل جديد للوالد: <strong class="text-gold">@parent.name</strong></span>
                    }
                    else
                    {
                        <span>أضف عضواً جديداً إلى شجرة العائلة</span>
                    }
                </p>
            </div>
            <div class="col-md-4 text-md-end">
                <a href="@Url.Action("Index", "Persone")" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left me-2"></i>العودة للقائمة
                </a>
            </div>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-xl-8 col-lg-10">
            <div class="create-form-container fade-in-up">
                <div class="card-islamic">
                    <div class="card-header">
                        <h5 class="mb-0">
                            <i class="fas fa-user-edit me-2"></i>
                            معلومات الفرد الجديد
                        </h5>
                    </div>
                    <div class="card-body">
                        <form asp-action="Create" method="post" id="createPersonForm">
                            <div asp-validation-summary="ModelOnly" class="alert alert-islamic-error" role="alert"></div>
                            
                            <!-- Personal Information Section -->
                            <div class="form-section">
                                <h6 class="section-title">
                                    <i class="fas fa-id-card text-gold me-2"></i>
                                    المعلومات الشخصية
                                </h6>
                                
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group mb-3">
                                            <label asp-for="name" class="form-label required">
                                                <i class="fas fa-user me-2 text-gold"></i>الاسم الكامل
                                            </label>
                                            <input asp-for="name" class="form-control arabic-input" placeholder="أدخل الاسم الكامل بالعربية" required>
                                            <span asp-validation-for="name" class="text-danger"></span>
                                            <div class="form-text">يُفضل كتابة الاسم باللغة العربية</div>
                                        </div>
                                    </div>
                                    
                                    <div class="col-md-6">
                                        <div class="form-group mb-3">
                                            <label asp-for="title" class="form-label">
                                                <i class="fas fa-crown me-2 text-gold"></i>اللقب أو الكنية
                                            </label>
                                            <input asp-for="title" class="form-control arabic-input" placeholder="مثال: أبو محمد، الشيخ، الدكتور">
                                            <span asp-validation-for="title" class="text-danger"></span>
                                            <div class="form-text">اللقب أو الكنية المعروف بها (اختياري)</div>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group mb-3">
                                            <label asp-for="Country" class="form-label">
                                                <i class="fas fa-globe me-2 text-gold"></i>البلد
                                            </label>
                                            <input asp-for="Country" class="form-control arabic-input" placeholder="مثال: المملكة العربية السعودية، الإمارات العربية المتحدة">
                                            <span asp-validation-for="Country" class="text-danger"></span>
                                            <div class="form-text">البلد الذي يقيم فيه الفرد (اختياري)</div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group mb-3">
                                            <label asp-for="PlaceOfRegistration" class="form-label">
                                                <i class="fas fa-map-marker-alt me-2 text-gold"></i>مكان القيد
                                            </label>
                                            <input asp-for="PlaceOfRegistration" class="form-control arabic-input" placeholder="مثال: الرياض، جدة، دبي">
                                            <span asp-validation-for="PlaceOfRegistration" class="text-danger"></span>
                                            <div class="form-text">مكان القيد أو التسجيل (اختياري)</div>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-12">
                                        <div class="form-group mb-3">
                                            <label asp-for="image" class="form-label">
                                                <i class="fas fa-image me-2 text-gold"></i>رابط الصورة الشخصية
                                            </label>
                                            <div class="input-group">
                                                <input asp-for="image" class="form-control" placeholder="https://example.com/image.jpg" id="imageInput">
                                                <button type="button" class="btn btn-outline-secondary" id="previewBtn">
                                                    <i class="fas fa-eye"></i> معاينة
                                                </button>
                                            </div>
                                            <span asp-validation-for="image" class="text-danger"></span>
                                            <div class="form-text">رابط صورة شخصية (اختياري)</div>
                                        </div>
                                        
                                        <!-- Image Preview -->
                                        <div id="imagePreview" class="image-preview d-none">
                                            <img id="previewImg" src="" alt="معاينة الصورة" class="preview-image">
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group mb-3">
                                            <label asp-for="DateOfBirth" class="form-label">
                                                <i class="fas fa-birthday-cake me-2 text-gold"></i>تاريخ الميلاد
                                            </label>
                                            <input asp-for="DateOfBirth" type="date" class="form-control">
                                            <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                                            <div class="form-text">تاريخ ميلاد الفرد (اختياري)</div>
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="form-group mb-3">
                                            <label asp-for="DateOfDeath" class="form-label">
                                                <i class="fas fa-mosque me-2 text-gold"></i>تاريخ الوفاة
                                            </label>
                                            <input asp-for="DateOfDeath" type="date" class="form-control">
                                            <span asp-validation-for="DateOfDeath" class="text-danger"></span>
                                            <div class="form-text">تاريخ وفاة الفرد (اختياري - اتركه فارغاً إذا كان على قيد الحياة)</div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Creation Mode Section -->
                            <div class="form-section">
                                <h6 class="section-title">
                                    <i class="fas fa-cog text-gold me-2"></i>
                                    نوع الإضافة
                                </h6>
                                
                                <div class="creation-mode-selector mb-4">
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="radio" name="creationMode" id="singleMode" value="single" checked>
                                        <label class="form-check-label" for="singleMode">
                                            <i class="fas fa-user me-2"></i>إضافة فرد واحد
                                        </label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="radio" name="creationMode" id="multipleMode" value="multiple">
                                        <label class="form-check-label" for="multipleMode">
                                            <i class="fas fa-users me-2"></i>إضافة أطفال متعددين
                                        </label>
                                    </div>
                                </div>
                            </div>

                            <!-- Single Person Section -->
                            <div id="singlePersonSection" class="form-section">
                                <h6 class="section-title">
                                    <i class="fas fa-user-edit text-gold me-2"></i>
                                    معلومات الفرد
                                </h6>
                                
                                <div class="single-person-form">
                                    <!-- This will contain the original single person form -->
                                </div>
                            </div>

                            <!-- Multiple Children Section -->
                            <div id="multipleChildrenSection" class="form-section d-none">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h6 class="section-title mb-0">
                                        <i class="fas fa-baby text-gold me-2"></i>
                                        معلومات الأبناء
                                    </h6>
                                    <div class="children-controls">
                                        <button type="button" id="addChildBtn" class="btn btn-sm btn-outline-primary">
                                            <i class="fas fa-plus me-1"></i>إضافة طفل
                                        </button>
                                        <button type="button" id="removeChildBtn" class="btn btn-sm btn-outline-danger">
                                            <i class="fas fa-minus me-1"></i>إزالة آخر طفل
                                        </button>
                                    </div>
                                </div>
                                
                                <div id="childrenContainer">
                                    <!-- Children forms will be added dynamically -->
                                </div>
                            </div>

                            <!-- Family Relations Section -->
                            <div class="form-section">
                                <h6 class="section-title">
                                    <i class="fas fa-sitemap text-gold me-2"></i>
                                    العلاقات العائلية
                                </h6>
                                
                                @if (ViewBag.GetParents != null && ((List<SukkarFamily.Models.Persone>)ViewBag.GetParents).Any())
                                {
                                    var parents = (List<SukkarFamily.Models.Persone>)ViewBag.GetParents;
                                    var maxGeneration = parents.Max(p => p.Generation);
                                    
                                    <!-- Hierarchical Parent-Child Drill-Down Filter System -->
                                    <div class="hierarchical-filter-section mb-4">
                                        <div class="filter-header d-flex justify-content-between align-items-center mb-3">
                                            <label class="form-label mb-0">
                                                <i class="fas fa-sitemap me-2 text-gold"></i>تصفية هرمية (الآباء والأبناء)
                                            </label>
                                            <div class="filter-controls">
                                                <button type="button" id="resetHierarchy" class="btn btn-sm btn-outline-secondary">
                                                    <i class="fas fa-undo me-1"></i>إعادة تعيين
                                                </button>
                                            </div>
                                        </div>

                                        <div id="hierarchyContainer">
                                            <!-- Root Level - Show all potential parents -->
                                            <div class="hierarchy-level" data-level="0">
                                                <div class="hierarchy-level-header">
                                                    <span class="hierarchy-level-number">1</span>
                                                    <span class="hierarchy-level-title">
                                                        <i class="fas fa-users me-2"></i>اختر الوالد الأول
                                                    </span>
                                                </div>
                                                <div class="row">
                                                    <div class="col-md-12">
                                                        <select class="form-select parent-level-select" data-level="0">
                                                            <option value="">اختر الوالد من جميع أفراد العائلة</option>
                                                            @foreach(var parent in parents.OrderBy(p => p.Generation).ThenBy(p => p.name))
                                                            {
                                                                var parentText = parent.name;
                                                                if (parent.Parent != null)
                                                                {
                                                                    parentText += " ابن/ابنة " + parent.Parent.name;
                                                                }
                                                                else
                                                                {
                                                                    parentText += " (الجد الأعلى)";
                                                                }
                                                                parentText += " - الجيل " + parent.Generation;

                                                                <option value="@parent.Id"
                                                                        data-generation="@parent.Generation"
                                                                        data-name="@parent.name"
                                                                        data-title="@(parent.title ?? "")"
                                                                        data-country="@(parent.Country ?? "")"
                                                                        data-image="@(parent.image ?? "")"
                                                                        data-parent-name="@(parent.Parent?.name ?? "")"
                                                                        data-children-count="@parents.Count(p => p.Parent != null && p.Parent.Id == parent.Id)">
                                                                    @parentText (@parents.Count(p => p.Parent != null && p.Parent.Id == parent.Id) أطفال)
                                                                </option>
                                                            }
                                                        </select>
                                                        <div class="form-text">اختر والد لعرض أطفاله فقط في المستوى التالي</div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="hierarchy-breadcrumb mt-3 d-none">
                                            <div class="breadcrumb-content">
                                                <i class="fas fa-route me-2 text-gold"></i>
                                                <span class="breadcrumb-text">المسار الهرمي: </span>
                                                <div id="breadcrumbPath" class="breadcrumb-path"></div>
                                            </div>
                                        </div>

                                        <div class="hierarchy-results mt-3">
                                            <div id="hierarchyStatus" class="text-muted">
                                                <i class="fas fa-info-circle me-1"></i>
                                                <span id="statusText">اختر والد لبدء التصفية الهرمية</span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="form-group mb-3">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <label asp-for="Parent" class="form-label mb-0">
                                                <i class="fas fa-user-tie me-2 text-gold"></i>الوالد
                                            </label>
                                            <div class="parent-selection-toggle">
                                                <div class="btn-group btn-group-sm" role="group">
                                                    <input type="radio" class="btn-check" name="parentSelectionMode" id="dropdownMode" value="dropdown" checked>
                                                    <label class="btn btn-outline-secondary" for="dropdownMode">
                                                        <i class="fas fa-list me-1"></i>قائمة
                                                    </label>

                                                    <input type="radio" class="btn-check" name="parentSelectionMode" id="treeMode" value="tree">
                                                    <label class="btn btn-outline-secondary" for="treeMode">
                                                        <i class="fas fa-sitemap me-1"></i>شجرة
                                                    </label>
                                                </div>
                                            </div>
                                        </div>
                                        
                                        <!-- Dropdown Selection Mode -->
                                        <div id="dropdownSelectionContainer">
                                            @if (parents.Count == 1)
                                            {
                                                var parent = parents.First();
                                                <div class="selected-parent-card">
                                                    <div class="parent-info">
                                                        <div class="parent-avatar">
                                                            @if (!string.IsNullOrEmpty(parent.image))
                                                            {
                                                                <img src="@parent.image" alt="@parent.name">
                                                            }
                                                            else
                                                            {
                                                                <i class="fas fa-user"></i>
                                                            }
                                                        </div>
                                                        <div class="parent-details">
                                                            <h6>
                                                                @parent.name
                                                                @if (parent.Parent != null)
                                                                {
                                                                    <span> ابن/ابنة @parent.Parent.name</span>
                                                                }
                                                                else
                                                                {
                                                                    <span> (الجد الأعلى)</span>
                                                                }
                                                            </h6>
                                                            <p class="mb-0">
                                                                @(parent.title ?? "بدون لقب") - الجيل @parent.Generation
                                                                @if (parent.Parent != null)
                                                                {
                                                                    <span class="ms-2"><i class="fas fa-arrow-up text-muted"></i> الوالد: @parent.Parent.name</span>
                                                                }
                                                            </p>
                                                        </div>
                                                    </div>
                                                    @Html.DropDownListFor(m => m.Parent, new SelectList(parents, "Id", "name"), new { @class = "d-none" })
                                                </div>
                                            }
                                            else
                                            {
                                                <!-- Search input for parent selection -->
                                                <div class="parent-search-container">
                                                    <div class="input-group">
                                                        <span class="input-group-text">
                                                            <i class="fas fa-search text-gold"></i>
                                                        </span>
                                                        <input type="text" id="parentSearchInput" class="form-control" placeholder="ابحث عن الوالد بالاسم...">
                                                        <button type="button" id="clearSearchBtn" class="btn btn-outline-secondary">
                                                            <i class="fas fa-arrow-left"></i>
                                                        </button>
                                                    </div>
                                                    <div class="form-text">ابدأ بالكتابة للبحث عن الوالد</div>
                                                </div>

                                                <select name="Parent" id="parentSelect" class="form-select" style="margin-top: 10px;">
                                                    <option value="">اختر الوالد</option>
                                                    @foreach(var parent in parents.OrderBy(p => p.Generation).ThenBy(p => p.name))
                                                    {
                                                        var parentText = parent.name;
                                                        if (parent.Parent != null)
                                                        {
                                                            parentText += " ابن/ابنة " + parent.Parent.name;
                                                        }
                                                        else
                                                        {
                                                            parentText += " (الجد الأعلى)";
                                                        }
                                                        parentText += " - الجيل " + parent.Generation;

                                                        <option value="@parent.Id"
                                                                data-generation="@parent.Generation"
                                                                data-name="@parent.name"
                                                                data-title="@(parent.title ?? "")"
                                                                data-country="@(parent.Country ?? "")"
                                                                data-image="@(parent.image ?? "")"
                                                                data-parent-name="@(parent.Parent?.name ?? "")"
                                                                data-search-text="@parentText.ToLower()">
                                                            @parentText
                                                        </option>
                                                    }
                                                </select>
                                            }
                                        </div>

                                        <!-- Tree Selection Mode -->
                                        <div id="treeSelectionContainer" class="d-none">
                                            <div class="family-tree-selector">
                                                <div class="tree-header">
                                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                                        <span class="tree-title">
                                                            <i class="fas fa-sitemap text-gold me-2"></i>اختر الوالد من الشجرة
                                                        </span>
                                                        <button type="button" id="expandAllTreeBtn" class="btn btn-sm btn-outline-secondary">
                                                            <i class="fas fa-expand-arrows-alt me-1"></i>توسيع الكل
                                                        </button>
                                                    </div>
                                                </div>

                                                <div id="familyTreeContainer" class="family-tree-container">
                                                    <!-- Tree will be generated by JavaScript -->
                                                </div>

                                                <div class="form-text mt-2">انقر على أي شخص في الشجرة لاختياره كوالد</div>
                                            </div>
                                        </div>

                                        <!-- Hidden input to store selected parent from tree -->
                                        <input type="hidden" id="selectedParentFromTree" name="Parent" />
                                        <span asp-validation-for="Parent" class="text-danger"></span>
                                        <div class="form-text">اختر الوالد من القائمة (اختياري للشخص الأول)</div>
                                    </div>

                                    <!-- Selected Parent Preview -->
                                    <div id="selectedParentPreview" class="selected-parent-preview d-none">
                                        <div class="preview-card">
                                            <div class="preview-header">
                                                <i class="fas fa-user-check text-success me-2"></i>
                                                <strong>الوالد المختار</strong>
                                            </div>
                                            <div class="preview-content">
                                                <div class="preview-avatar">
                                                    <img id="previewImage" src="" alt="" style="display: none;">
                                                    <i id="previewIcon" class="fas fa-user"></i>
                                                </div>
                                                <div class="preview-details">
                                                    <h6 id="previewName"></h6>
                                                    <p id="previewInfo" class="mb-1"></p>
                                                    <span id="previewGeneration" class="generation-badge"></span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="generation-info-card">
                                        <div class="info-content">
                                            <i class="fas fa-info-circle text-primary me-2"></i>
                                            <span>
                                                @if (parents.Count == 1)
                                                {
                                                    <span>سيتم تعيين هذا الفرد في الجيل <strong>@(parents.First().Generation + 1)</strong> تلقائياً</span>
                                                }
                                                else
                                                {
                                                    <span>سيتم تحديد الجيل تلقائياً بناءً على الوالد المختار</span>
                                                }
                                            </span>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <!-- No existing family members - Root person creation -->
                                    <div class="root-person-info-card">
                                        <div class="info-content">
                                            <i class="fas fa-crown text-gold me-3" style="font-size: 2rem;"></i>
                                            <div>
                                                <h6 class="text-gold mb-2">إنشاء الجد الأعلى للعائلة</h6>
                                                <p class="mb-0 text-muted">
                                                    هذا هو أول شخص يتم إضافته لشجرة العائلة وسيصبح الجد الأعلى.
                                                    سيتم تعيينه في الجيل الأول تلقائياً.
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <!-- Hidden input to indicate this is a root person -->
                                    <input type="hidden" name="IsRootPerson" value="true" />
                                }
                            </div>

                            <!-- Submit Section -->
                            <div class="form-section">
                                <div class="submit-actions">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <button type="submit" class="btn btn-gold btn-lg w-100" id="submitBtn">
                                                <i class="fas fa-save me-2"></i>إضافة الفرد
                                            </button>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="btn-group w-100">
                                                <button type="button" class="btn btn-outline-secondary btn-lg" onclick="resetForm()">
                                                    <i class="fas fa-redo me-2"></i>إعادة تعيين
                                                </button>
                                                <a href="@Url.Action("Index", "Persone")" class="btn btn-outline-danger btn-lg">
                                                    <i class="fas fa-arrow-left me-2"></i>إلغاء
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <!-- Family Tree Data for JavaScript -->
    <script>
        @{
            object treeData = new object();
            if (ViewBag.GetParents != null)
            {
                var parents = (List<SukkarFamily.Models.Persone>)ViewBag.GetParents;

                // Debug: Log each person being processed
                foreach(var p in parents)
                {
                    System.Diagnostics.Debug.WriteLine($"Processing person: Id={p.Id}, Name={p.name}, Title={p.title}, Generation={p.Generation}, ParentId={p.Parent?.Id}");
                }

                treeData = parents
                    .OrderBy(p => p.Generation)
                    .ThenBy(p => p.name)
                    .Select(p => new {
                        Id = p.Id,
                        name = p.name ?? "",
                        title = p.title ?? "",
                        Country = p.Country ?? "",
                        image = p.image ?? "",
                        Generation = p.Generation,
                        Parent = p.Parent?.Id // Only store the parent ID, not the full object
                    }).ToList();
            }
        }
        window.familyTreeData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(treeData));

        // Debug: Log the serialized data
        console.log('Serialized Family Tree Data:', window.familyTreeData);
        console.log('Type of familyTreeData:', typeof window.familyTreeData);
        console.log('Is array:', Array.isArray(window.familyTreeData));

        // Test the hierarchical system data
        if (window.familyTreeData && window.familyTreeData.length > 0) {
            console.log('Sample of family tree data:');
            console.log('Total people:', window.familyTreeData.length);
            console.log('First person (full object):', window.familyTreeData[0]);
            console.log('First person properties:', Object.keys(window.familyTreeData[0]));
            console.log('First person Id property value and type:', window.familyTreeData[0].Id, typeof window.familyTreeData[0].Id);

            // Check all people's IDs
            console.log('All person IDs and names:');
            window.familyTreeData.forEach((person, index) => {
                console.log(`Person ${index}: ID=${person.Id} (${typeof person.Id}), Name=${person.name}, Parent=${person.Parent}`);
            });

            // Test finding children only if we have valid IDs
            if (window.familyTreeData[0].Id !== undefined && window.familyTreeData[0].Id !== null) {
                const sampleParent = window.familyTreeData[0];
                const children = window.familyTreeData.filter(person => person.Parent == sampleParent.Id);
                console.log(`Sample parent ${sampleParent.name} has ${children.length} children:`, children.map(c => c.name));
            } else {
                console.error('IDs are undefined in the family tree data!');
            }
        }
    </script>
    
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            initializeForm();
            setupImagePreview();
            setupArabicInputs();
            setupFormValidation();
            setupCreationModeToggle();
            setupMultipleChildrenFunctionality();
            setupGenerationFilter();
            setupParentPreview();
            setupParentSearch();
            setupParentSelectionToggle();
            setupFamilyTree();
            setupHierarchicalFilters();
        });

        function initializeForm() {
            // Focus on first input
            const nameInput = document.querySelector('input[name="name"]');
            if (nameInput) {
                nameInput.focus();
            }

            // Add loading state to submit button
            const form = document.getElementById('createPersonForm');
            const submitBtn = document.getElementById('submitBtn');
            
            form.addEventListener('submit', function() {
                submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>جاري الإضافة...';
                submitBtn.disabled = true;
            });
        }

        function setupImagePreview() {
            const imageInput = document.getElementById('imageInput');
            const previewBtn = document.getElementById('previewBtn');
            const imagePreview = document.getElementById('imagePreview');
            const previewImg = document.getElementById('previewImg');

            previewBtn.addEventListener('click', function() {
                const imageUrl = imageInput.value.trim();
                
                if (imageUrl) {
                    previewImg.src = imageUrl;
                    previewImg.onload = function() {
                        imagePreview.classList.remove('d-none');
                        IslamicSite.showToast('تم تحميل الصورة بنجاح', 'success');
                    };
                    previewImg.onerror = function() {
                        IslamicSite.showToast('فشل في تحميل الصورة. تأكد من صحة الرابط', 'error');
                    };
                } else {
                    imagePreview.classList.add('d-none');
                }
            });

            // Auto preview on input change
            imageInput.addEventListener('blur', function() {
                if (this.value.trim()) {
                    previewBtn.click();
                }
            });
        }

        function setupArabicInputs() {
            const arabicInputs = document.querySelectorAll('.arabic-input');
            
            arabicInputs.forEach(input => {
                input.addEventListener('input', function() {
                    const arabicPattern = /[\u0600-\u06FF]/;
                    if (arabicPattern.test(this.value)) {
                        this.style.direction = 'rtl';
                        this.style.textAlign = 'right';
                        this.classList.add('arabic-text');
                    } else if (this.value.trim() === '') {
                        this.style.direction = 'rtl';
                        this.style.textAlign = 'right';
                    }
                });

                // Set initial RTL direction
                input.style.direction = 'rtl';
                input.style.textAlign = 'right';
            });
        }

        function setupFormValidation() {
            const form = document.getElementById('createPersonForm');
            
            form.addEventListener('submit', function(e) {
                if (!validateForm()) {
                    e.preventDefault();
                    IslamicSite.showToast('يرجى تصحيح الأخطاء في النموذج', 'error');
                }
            });
        }

        function validateForm() {
            let isValid = true;
            
            // Validate name (required and should be Arabic)
            const nameInput = document.querySelector('input[name="name"]');
            const arabicPattern = /[\u0600-\u06FF]/;
            
            if (!nameInput.value.trim()) {
                showFieldError(nameInput, 'الاسم مطلوب');
                isValid = false;
            } else if (!arabicPattern.test(nameInput.value)) {
                showFieldError(nameInput, 'يُفضل كتابة الاسم بالعربية');
            } else {
                clearFieldError(nameInput);
            }

            // Validate parent selection (optional for root person)
            const parentSelect = document.querySelector('select[name="Parent"]');
            const isRootPerson = document.querySelector('input[name="IsRootPerson"]');
            
            if (parentSelect && !parentSelect.value && !isRootPerson) {
                showFieldError(parentSelect, 'يجب اختيار الوالد');
                isValid = false;
            } else if (parentSelect) {
                clearFieldError(parentSelect);
            }

            return isValid;
        }

        function showFieldError(field, message) {
            field.classList.add('is-invalid');
            
            let errorElement = field.parentNode.querySelector('.invalid-feedback');
            if (!errorElement) {
                errorElement = document.createElement('div');
                errorElement.className = 'invalid-feedback';
                field.parentNode.appendChild(errorElement);
            }
            errorElement.textContent = message;
        }

        function clearFieldError(field) {
            field.classList.remove('is-invalid');
            const errorElement = field.parentNode.querySelector('.invalid-feedback');
            if (errorElement) {
                errorElement.remove();
            }
        }

        function resetForm() {
            document.getElementById('createPersonForm').reset();
            document.getElementById('imagePreview').classList.add('d-none');
            
            // Clear any validation errors
            document.querySelectorAll('.is-invalid').forEach(el => {
                el.classList.remove('is-invalid');
            });
            document.querySelectorAll('.invalid-feedback').forEach(el => {
                el.remove();
            });
            
            IslamicSite.showToast('تم إعادة تعيين النموذج', 'info');
        }

        // Parent selection change handler
        const parentSelect = document.querySelector('select[name="Parent"]');
        if (parentSelect) {
            parentSelect.addEventListener('change', function() {
                const selectedOption = this.options[this.selectedIndex];
                if (selectedOption.value) {
                    // You could fetch and display parent details here
                    console.log('تم اختيار الوالد:', selectedOption.text);
                }
            });
        }

        // Creation Mode Toggle
        function setupCreationModeToggle() {
            const singleModeRadio = document.getElementById('singleMode');
            const multipleModeRadio = document.getElementById('multipleMode');
            const singleSection = document.getElementById('singlePersonSection');
            const multipleSection = document.getElementById('multipleChildrenSection');

            singleModeRadio.addEventListener('change', function() {
                if (this.checked) {
                    singleSection.classList.remove('d-none');
                    multipleSection.classList.add('d-none');
                    // Clear multiple children data
                    document.getElementById('childrenContainer').innerHTML = '';
                }
            });

            multipleModeRadio.addEventListener('change', function() {
                if (this.checked) {
                    singleSection.classList.add('d-none');
                    multipleSection.classList.remove('d-none');
                    // Clear single person data
                    const singleInputs = singleSection.querySelectorAll('input:not([type="hidden"])');
                    singleInputs.forEach(input => input.value = '');
                    // Initialize with first child
                    if (document.getElementById('childrenContainer').children.length === 0) {
                        addChild();
                    }
                }
            });
        }

        // Multiple Children Functionality
        let childCounter = 0;

        function setupMultipleChildrenFunctionality() {
            document.getElementById('addChildBtn').addEventListener('click', addChild);
            document.getElementById('removeChildBtn').addEventListener('click', removeLastChild);
        }

        function addChild() {
            const container = document.getElementById('childrenContainer');
            const childDiv = document.createElement('div');
            childDiv.className = 'child-form-group';
            childDiv.setAttribute('data-child-index', childCounter);
            
            childDiv.innerHTML = `
                <div class="child-header">
                    <h6 class="child-title">
                        <i class="fas fa-child text-gold me-2"></i>الطفل رقم <span class="child-number">${childCounter + 1}</span>
                    </h6>
                    <button type="button" class="btn btn-sm btn-outline-danger remove-child-btn" onclick="removeChild(this)">
                        <i class="fas fa-minus"></i>
                    </button>
                </div>
                
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label class="form-label required">
                                <i class="fas fa-user me-2 text-gold"></i>الاسم الكامل
                            </label>
                            <input name="ChildNames" class="form-control arabic-input" placeholder="أدخل اسم الطفل" required>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label class="form-label">
                                <i class="fas fa-crown me-2 text-gold"></i>اللقب أو الكنية
                            </label>
                            <input name="ChildTitles" class="form-control arabic-input" placeholder="مثال: أبو أحمد">
                        </div>
                    </div>
                </div>
                
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label class="form-label">
                                <i class="fas fa-globe me-2 text-gold"></i>البلد
                            </label>
                            <input name="ChildCountries" class="form-control arabic-input" placeholder="البلد">
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label class="form-label">
                                <i class="fas fa-map-marker-alt me-2 text-gold"></i>مكان القيد
                            </label>
                            <input name="ChildPlacesOfRegistration" class="form-control arabic-input" placeholder="مثال: الرياض، جدة">
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label class="form-label">
                                <i class="fas fa-birthday-cake me-2 text-gold"></i>تاريخ الميلاد
                            </label>
                            <input name="ChildDatesOfBirth" type="date" class="form-control">
                            <div class="form-text">تاريخ ميلاد الطفل (اختياري)</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label class="form-label">
                                <i class="fas fa-mosque me-2 text-gold"></i>تاريخ الوفاة
                            </label>
                            <input name="ChildDatesOfDeath" type="date" class="form-control">
                            <div class="form-text">تاريخ وفاة الطفل (اختياري)</div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-12">
                        <div class="form-group mb-3">
                            <label class="form-label">
                                <i class="fas fa-image me-2 text-gold"></i>رابط الصورة
                            </label>
                            <input name="ChildImages" class="form-control" placeholder="https://example.com/image.jpg">
                        </div>
                    </div>
                </div>
            `;
            
            container.appendChild(childDiv);
            childCounter++;
            updateChildNumbers();
            
            // Setup Arabic inputs for new child
            setupArabicInputsForElement(childDiv);
            
            // Focus on name input
            const nameInput = childDiv.querySelector('input[name="ChildNames"]');
            if (nameInput) nameInput.focus();
        }

        function removeChild(button) {
            const childDiv = button.closest('.child-form-group');
            if (document.querySelectorAll('.child-form-group').length > 1) {
                childDiv.remove();
                updateChildNumbers();
            } else {
                alert('يجب أن يكون هناك طفل واحد على الأقل');
            }
        }

        function removeLastChild() {
            const children = document.querySelectorAll('.child-form-group');
            if (children.length > 1) {
                children[children.length - 1].remove();
                updateChildNumbers();
            } else {
                alert('يجب أن يكون هناك طفل واحد على الأقل');
            }
        }

        function updateChildNumbers() {
            const children = document.querySelectorAll('.child-form-group');
            children.forEach((child, index) => {
                const numberSpan = child.querySelector('.child-number');
                if (numberSpan) {
                    numberSpan.textContent = index + 1;
                }
                child.setAttribute('data-child-index', index);
            });
        }

        function setupArabicInputsForElement(element) {
            const arabicInputs = element.querySelectorAll('.arabic-input');
            
            arabicInputs.forEach(input => {
                input.addEventListener('input', function() {
                    const arabicPattern = /[\u0600-\u06FF]/;
                    if (arabicPattern.test(this.value)) {
                        this.style.direction = 'rtl';
                        this.style.textAlign = 'right';
                        this.classList.add('arabic-text');
                    } else if (this.value.trim() === '') {
                        this.style.direction = 'rtl';
                        this.style.textAlign = 'right';
                    }
                });

                // Set initial RTL direction
                input.style.direction = 'rtl';
                input.style.textAlign = 'right';
            });
        }

        // Hierarchical Filter Functionality
        function setupHierarchicalFilters() {
            console.log('Setting up hierarchical filters...');
            console.log('Family tree data available:', window.familyTreeData);

            const resetBtn = document.getElementById('resetHierarchy');

            if (resetBtn) {
                resetBtn.addEventListener('click', resetHierarchy);
                console.log('Reset button listener added');
            } else {
                console.error('Reset button not found!');
            }

            // Setup initial listeners
            setupHierarchyLevelListeners();
            updateHierarchyStatus();

            console.log('Hierarchical filters setup complete');
        }

        let hierarchyLevelCounter = 0;
        let hierarchyPath = []; // Stores the selected path: [parentId1, parentId2, ...]

        function setupHierarchyLevelListeners() {
            const container = document.getElementById('hierarchyContainer');
            console.log('Setting up hierarchy level listeners, container:', container);

            if (!container) {
                console.error('hierarchyContainer not found!');
                return;
            }

            // Setup listeners for all parent-level-select elements
            container.addEventListener('change', function(e) {
                console.log('Change event triggered on:', e.target);

                if (e.target.classList.contains('parent-level-select')) {
                    const level = parseInt(e.target.getAttribute('data-level'));
                    const selectedParentId = e.target.value;

                    console.log(`Parent selected: level=${level}, parentId=${selectedParentId}`);

                    if (selectedParentId) {
                        handleParentSelection(level, selectedParentId);
                    } else {
                        // Clear selection - remove all levels after this one
                        console.log(`Clearing hierarchy after level ${level}`);
                        clearHierarchyAfterLevel(level);
                        updateBreadcrumb();
                        updateHierarchyStatus();
                        updateFinalParentDropdown();
                    }
                } else {
                    console.log('Target does not have parent-level-select class:', e.target.className);
                }
            });

            // Also check if the initial dropdown exists
            const initialSelect = container.querySelector('.parent-level-select[data-level="0"]');
            console.log('Initial parent select found:', initialSelect);
        }

        function handleParentSelection(level, selectedParentId) {
            console.log(`handleParentSelection called: level=${level}, selectedParentId=${selectedParentId}`);

            // Update hierarchy path
            hierarchyPath = hierarchyPath.slice(0, level + 1);
            hierarchyPath[level] = selectedParentId;
            console.log('Updated hierarchy path:', hierarchyPath);

            // Clear any levels after this one
            clearHierarchyAfterLevel(level);

            // Get children of selected parent
            const children = getChildrenOfParent(selectedParentId);
            console.log(`Children found for parent ${selectedParentId}:`, children);

            if (children.length > 0) {
                // Create next level showing children
                console.log(`Adding hierarchy level ${level + 1} with ${children.length} children`);
                addHierarchyLevel(level + 1, children, selectedParentId);
            } else {
                console.log('No children found, not creating new level');
            }

            // Update breadcrumb and status
            updateBreadcrumb();
            updateHierarchyStatus();

            // Update final parent selection dropdown
            updateFinalParentDropdown();
        }

        function getChildrenOfParent(parentId) {
            if (!window.familyTreeData) return [];
            return window.familyTreeData.filter(person => person.Parent == parentId);
        }

        function addHierarchyLevel(level, children, parentId) {
            console.log(`addHierarchyLevel called: level=${level}, children.length=${children.length}, parentId=${parentId}`);

            const container = document.getElementById('hierarchyContainer');
            if (!container) {
                console.error('hierarchyContainer not found!');
                return;
            }

            const parentName = getPersonName(parentId);
            console.log(`Parent name: ${parentName}`);

            const hierarchyLevel = document.createElement('div');
            hierarchyLevel.className = 'hierarchy-level';
            hierarchyLevel.setAttribute('data-level', level);

            const childOptions = children.map(child => {
                const childrenCount = getChildrenOfParent(child.Id).length;
                console.log(`Child: ${child.name}, has ${childrenCount} children`);
                return `
                    <option value="${child.Id}"
                            data-generation="${child.Generation}"
                            data-name="${child.name}"
                            data-title="${child.title || ''}"
                            data-country="${child.Country || ''}"
                            data-image="${child.image || ''}"
                            data-children-count="${childrenCount}">
                        ${child.name}${child.title ? ` (${child.title})` : ''} - الجيل ${child.Generation} (${childrenCount} أطفال)
                    </option>
                `;
            }).join('');

            hierarchyLevel.innerHTML = `
                <div class="hierarchy-level-header">
                    <span class="hierarchy-level-number">${level + 1}</span>
                    <span class="hierarchy-level-title">
                        <i class="fas fa-child me-2"></i>أطفال ${parentName}
                    </span>
                </div>
                <div class="row">
                    <div class="col-md-12">
                        <select class="form-select parent-level-select" data-level="${level}">
                            <option value="">اختر من أطفال ${parentName} (${children.length} طفل)</option>
                            ${childOptions}
                        </select>
                        <div class="form-text">اختر طفل لعرض أطفاله في المستوى التالي</div>
                    </div>
                </div>
            `;

            console.log('Adding hierarchy level to container');
            container.appendChild(hierarchyLevel);
            hierarchyLevelCounter = Math.max(hierarchyLevelCounter, level);

            // Animation
            hierarchyLevel.style.opacity = '0';
            hierarchyLevel.style.transform = 'translateY(-20px)';
            requestAnimationFrame(() => {
                hierarchyLevel.style.transition = 'all 0.3s ease';
                hierarchyLevel.style.opacity = '1';
                hierarchyLevel.style.transform = 'translateY(0)';
            });

            console.log('Hierarchy level added successfully');
        }

        function clearHierarchyAfterLevel(level) {
            const container = document.getElementById('hierarchyContainer');
            const levelsToRemove = container.querySelectorAll(`.hierarchy-level[data-level]:not([data-level="${level}"]):not([data-level="0"])`);

            levelsToRemove.forEach(levelElement => {
                const levelNum = parseInt(levelElement.getAttribute('data-level'));
                if (levelNum > level) {
                    levelElement.style.transition = 'all 0.3s ease';
                    levelElement.style.opacity = '0';
                    levelElement.style.transform = 'translateY(-20px)';
                    setTimeout(() => {
                        if (levelElement.parentNode) {
                            levelElement.remove();
                        }
                    }, 300);
                }
            });

            // Update hierarchy path
            hierarchyPath = hierarchyPath.slice(0, level + 1);
        }

        function resetHierarchy() {
            // Reset all selections
            document.querySelectorAll('.parent-level-select').forEach(select => {
                select.selectedIndex = 0;
            });

            // Clear hierarchy path
            hierarchyPath = [];

            // Remove all levels except the first one
            clearHierarchyAfterLevel(-1);

            // Update UI
            updateBreadcrumb();
            updateHierarchyStatus();
            updateFinalParentDropdown();
        }

        function updateBreadcrumb() {
            const breadcrumb = document.querySelector('.hierarchy-breadcrumb');
            const breadcrumbPath = document.getElementById('breadcrumbPath');

            if (hierarchyPath.length === 0) {
                breadcrumb.classList.add('d-none');
                return;
            }

            breadcrumb.classList.remove('d-none');

            const pathNames = hierarchyPath.map((parentId, index) => {
                const person = getPersonById(parentId);
                return person ? person.name : 'غير معروف';
            });

            breadcrumbPath.innerHTML = pathNames.map((name, index) => {
                const isLast = index === pathNames.length - 1;
                return `
                    <span class="breadcrumb-item ${isLast ? 'active' : ''}">
                        ${name}
                        ${!isLast ? '<i class="fas fa-chevron-left mx-2 text-muted"></i>' : ''}
                    </span>
                `;
            }).join('');
        }

        function updateHierarchyStatus() {
            const statusText = document.getElementById('statusText');

            if (hierarchyPath.length === 0) {
                statusText.textContent = 'اختر والد لبدء التصفية الهرمية';
            } else {
                const lastSelectedParentId = hierarchyPath[hierarchyPath.length - 1];
                const lastSelectedParent = getPersonById(lastSelectedParentId);

                console.log(`updateHierarchyStatus: parentId=${lastSelectedParentId}, found person:`, lastSelectedParent);

                if (!lastSelectedParent) {
                    statusText.textContent = `خطأ: لم يتم العثور على الشخص المحدد (ID: ${lastSelectedParentId})`;
                    return;
                }

                const childrenCount = getChildrenOfParent(lastSelectedParentId).length;

                if (childrenCount > 0) {
                    statusText.textContent = `تم اختيار ${lastSelectedParent.name} - يمكنك الآن اختيار من ${childrenCount} طفل`;
                } else {
                    statusText.textContent = `تم اختيار ${lastSelectedParent.name} - هذا الشخص ليس له أطفال`;
                }
            }
        }

        function updateFinalParentDropdown() {
            const parentSelect = document.getElementById('parentSelect');
            if (!parentSelect) return;

            let availableParents = [];

            if (hierarchyPath.length === 0) {
                // Show all parents
                availableParents = window.familyTreeData || [];
            } else {
                // Show only children of the last selected parent
                const lastSelectedParentId = hierarchyPath[hierarchyPath.length - 1];
                availableParents = getChildrenOfParent(lastSelectedParentId);
            }

            // Clear and populate dropdown
            parentSelect.innerHTML = '<option value="">اختر الوالد</option>';

            availableParents.forEach(person => {
                const option = document.createElement('option');
                option.value = person.Id;
                option.setAttribute('data-generation', person.Generation);
                option.setAttribute('data-name', person.name);
                option.setAttribute('data-title', person.title || '');
                option.setAttribute('data-country', person.Country || '');
                option.setAttribute('data-image', person.image || '');
                option.setAttribute('data-parent-name', getParentName(person.Parent) || '');

                let text = person.name;
                if (person.Parent) {
                    text += ` ابن/ابنة ${getParentName(person.Parent)}`;
                } else {
                    text += ' (الجد الأعلى)';
                }
                text += ` - الجيل ${person.Generation}`;

                option.textContent = text;
                parentSelect.appendChild(option);
            });
        }

        function getPersonById(personId) {
            if (!window.familyTreeData) {
                console.log('getPersonById: familyTreeData is not available');
                return null;
            }

            console.log(`getPersonById: searching for ID ${personId} (type: ${typeof personId})`);
            console.log('Available IDs:', window.familyTreeData.map(p => `${p.Id} (${typeof p.Id})`));

            const person = window.familyTreeData.find(p => p.Id == personId);
            console.log(`getPersonById result:`, person);

            return person;
        }

        function getPersonName(personId) {
            const person = getPersonById(personId);
            return person ? person.name : 'غير معروف';
        }

        // Generation Filter Functionality (Updated)
        function setupGenerationFilter() {
            // This is now handled by setupHierarchicalFilters
        }

        // Filter HTML creators
        function createGenerationFilterHTML(level) {
            const parents = window.familyTreeData || [];
            const generations = [...new Set(parents.map(p => p.Generation))].sort((a, b) => a - b);

            return `
                <select class="form-select generation-filter" data-level="${level}">
                    <option value="">جميع الأجيال</option>
                    ${generations.map(gen =>
                        `<option value="${gen}">الجيل ${gen} (${parents.filter(p => p.Generation === gen).length} أشخاص)</option>`
                    ).join('')}
                </select>
                <div class="form-text">اختر الجيل لتصفية الوالدين</div>
            `;
        }

        function createNameFilterHTML(level) {
            return `
                <input type="text" class="form-control name-filter" data-level="${level}" placeholder="ابحث بالاسم...">
                <div class="form-text">اكتب جزء من الاسم للبحث</div>
            `;
        }

        function createTitleFilterHTML(level) {
            const parents = window.familyTreeData || [];
            const titles = [...new Set(parents.map(p => p.title).filter(t => t && t.trim()))].sort();

            return `
                <select class="form-select title-filter" data-level="${level}">
                    <option value="">جميع الألقاب</option>
                    ${titles.map(title =>
                        `<option value="${title}">${title} (${parents.filter(p => p.title === title).length} أشخاص)</option>`
                    ).join('')}
                </select>
                <div class="form-text">اختر اللقب لتصفية الوالدين</div>
            `;
        }

        function createCountryFilterHTML(level) {
            const parents = window.familyTreeData || [];
            const countries = [...new Set(parents.map(p => p.Country).filter(c => c && c.trim()))].sort();

            return `
                <select class="form-select country-filter" data-level="${level}">
                    <option value="">جميع البلدان</option>
                    ${countries.map(country =>
                        `<option value="${country}">${country} (${parents.filter(p => p.Country === country).length} أشخاص)</option>`
                    ).join('')}
                </select>
                <div class="form-text">اختر البلد لتصفية الوالدين</div>
            `;
        }

        function createParentFilterHTML(level) {
            const parents = window.familyTreeData || [];
            const parentNames = [...new Set(parents.map(p => p.Parent).filter(pid => pid))];
            const parentObjects = parentNames.map(pid => parents.find(p => p.Id === pid)).filter(p => p);

            return `
                <select class="form-select parent-filter" data-level="${level}">
                    <option value="">جميع الوالدين</option>
                    ${parentObjects.map(parent =>
                        `<option value="${parent.Id}">${parent.name} (${parents.filter(p => p.Parent === parent.Id).length} أطفال)</option>`
                    ).join('')}
                </select>
                <div class="form-text">اختر الوالد لعرض أطفاله فقط</div>
            `;
        }

        function setupFilterContentListeners(contentDiv, filterType) {
            const inputs = contentDiv.querySelectorAll('input, select');
            inputs.forEach(input => {
                if (!input.hasAttribute('data-listener-attached')) {
                    input.addEventListener('input', applyMultiLevelFilters);
                    input.addEventListener('change', applyMultiLevelFilters);
                    input.setAttribute('data-listener-attached', 'true');
                }
            });
        }

        function removeFilterLevel(level) {
            if (level == 1) return; // Can't remove first level

            const filterLevel = document.querySelector(`.filter-level[data-level="${level}"]`);
            if (filterLevel) {
                filterLevel.style.transition = 'all 0.3s ease';
                filterLevel.style.opacity = '0';
                filterLevel.style.transform = 'translateY(-20px)';
                setTimeout(() => {
                    filterLevel.remove();
                    updateRemoveButtonStates();
                    applyMultiLevelFilters();
                }, 300);
            }
        }

        function clearAllFilters() {
            // Reset all filter inputs
            document.querySelectorAll('.filter-level input, .filter-level select').forEach(input => {
                if (input.type === 'text') {
                    input.value = '';
                } else {
                    input.selectedIndex = 0;
                }
            });

            // Remove all except first level
            const filterLevels = document.querySelectorAll('.filter-level[data-level]:not([data-level="1"])');
            filterLevels.forEach(level => {
                level.remove();
            });

            // Reset counter
            filterLevelCounter = 1;

            // Update states
            updateRemoveButtonStates();
            applyMultiLevelFilters();
        }

        function updateRemoveButtonStates() {
            const removeButtons = document.querySelectorAll('.remove-filter-level');
            removeButtons.forEach(btn => {
                const level = btn.getAttribute('data-level');
                btn.disabled = (level == 1);
            });
        }

        function applyMultiLevelFilters() {
            const parentSelect = document.getElementById('parentSelect');
            if (!parentSelect || !window.originalParentOptions) return;

            let filteredData = [...window.familyTreeData];

            // Apply each filter level
            const filterLevels = document.querySelectorAll('.filter-level');
            filterLevels.forEach(level => {
                const levelNum = level.getAttribute('data-level');
                filteredData = applyFilterLevel(filteredData, level);
            });

            // Update parent dropdown
            updateParentDropdown(filteredData);

            // Update count display
            updateFilterResults(filteredData.length);

            // Clear tree selection if switching modes
            clearTreeSelection();
        }

        function applyFilterLevel(data, levelElement) {
            const generationFilter = levelElement.querySelector('.generation-filter');
            const nameFilter = levelElement.querySelector('.name-filter');
            const titleFilter = levelElement.querySelector('.title-filter');
            const countryFilter = levelElement.querySelector('.country-filter');
            const parentFilter = levelElement.querySelector('.parent-filter');

            let result = [...data];

            if (generationFilter && generationFilter.value) {
                result = result.filter(p => p.Generation == generationFilter.value);
            }

            if (nameFilter && nameFilter.value.trim()) {
                const searchTerm = nameFilter.value.trim().toLowerCase();
                result = result.filter(p => (p.name || '').toLowerCase().includes(searchTerm));
            }

            if (titleFilter && titleFilter.value) {
                result = result.filter(p => p.title === titleFilter.value);
            }

            if (countryFilter && countryFilter.value) {
                result = result.filter(p => p.Country === countryFilter.value);
            }

            if (parentFilter && parentFilter.value) {
                result = result.filter(p => p.Parent == parentFilter.value);
            }

            return result;
        }

        function updateParentDropdown(filteredData) {
            const parentSelect = document.getElementById('parentSelect');
            if (!parentSelect) return;

            // Clear current options
            parentSelect.innerHTML = '<option value="">اختر الوالد</option>';

            // Add filtered options
            filteredData.forEach(person => {
                const option = document.createElement('option');
                option.value = person.Id;
                option.setAttribute('data-generation', person.Generation);
                option.setAttribute('data-name', person.name);
                option.setAttribute('data-title', person.title || '');
                option.setAttribute('data-country', person.Country || '');
                option.setAttribute('data-image', person.image || '');
                option.setAttribute('data-parent-name', getParentName(person.Parent) || '');

                let text = person.name;
                if (person.Parent) {
                    text += ` ابن/ابنة ${getParentName(person.Parent)}`;
                } else {
                    text += ' (الجد الأعلى)';
                }
                text += ` - الجيل ${person.Generation}`;

                option.textContent = text;
                parentSelect.appendChild(option);
            });
        }

        function updateFilterResults(count) {
            const countText = document.getElementById('countText');
            if (countText) {
                const totalCount = window.familyTreeData ? window.familyTreeData.length : 0;
                if (count === totalCount) {
                    countText.textContent = `جميع الأفراد متاحون (${count} شخص)`;
                } else {
                    countText.textContent = `${count} من ${totalCount} شخص متاح بعد التصفية`;
                }
            }
        }

        // Combined filter function for generation and search (Legacy - updated to use hierarchical)
        function applyFilters() {
            // This is now handled by the hierarchical system
            updateFinalParentDropdown();
        }

        // Parent Preview Functionality
        function setupParentPreview() {
            const parentSelect = document.getElementById('parentSelect');
            if (!parentSelect) return;

            parentSelect.addEventListener('change', function() {
                const selectedOption = this.options[this.selectedIndex];
                
                if (selectedOption.value) {
                    showParentPreview(selectedOption);
                } else {
                    hideParentPreview();
                }
            });
        }

        function showParentPreview(option) {
            const preview = document.getElementById('selectedParentPreview');
            const previewImage = document.getElementById('previewImage');
            const previewIcon = document.getElementById('previewIcon');
            const previewName = document.getElementById('previewName');
            const previewInfo = document.getElementById('previewInfo');
            const previewGeneration = document.getElementById('previewGeneration');
            
            // Set parent details
            const name = option.dataset.name;
            const title = option.dataset.title;
            const country = option.dataset.country;
            const image = option.dataset.image;
            const generation = option.dataset.generation;
            const parentName = option.dataset.parentName;
            
            // Build parent name with hierarchy
            let displayName = name;
            if (parentName && parentName.trim() !== '') {
                displayName += ` ابن/ابنة ${parentName}`;
            } else {
                displayName += ' (الجد الأعلى)';
            }
            previewName.textContent = displayName;
            
            // Build info string
            let info = [];
            if (title) info.push(`اللقب: ${title}`);
            if (country) info.push(`البلد: ${country}`);
            if (parentName && parentName.trim() !== '') {
                info.push(`الوالد: ${parentName}`);
            }
            previewInfo.textContent = info.length > 0 ? info.join(' • ') : 'لا توجد معلومات إضافية';
            
            // Handle image/icon
            if (image && image.trim() !== '') {
                previewImage.src = image;
                previewImage.style.display = '';
                previewIcon.style.display = 'none';
            } else {
                previewImage.style.display = 'none';
                previewIcon.style.display = '';
            }
            
            // Set generation badge
            previewGeneration.textContent = `الجيل ${generation}`;
            previewGeneration.className = `generation-badge generation-${generation}`;
            
            // Show preview
            preview.classList.remove('d-none');
        }

        function hideParentPreview() {
            const preview = document.getElementById('selectedParentPreview');
            if (preview) {
                preview.classList.add('d-none');
            }
        }

        // Parent Search Functionality
        function setupParentSearch() {
            const searchInput = document.getElementById('parentSearchInput');
            const clearBtn = document.getElementById('clearSearchBtn');
            const parentSelect = document.getElementById('parentSelect');

            if (!searchInput || !parentSelect) return;

            // Store original options globally for use by applyFilters
            window.originalParentOptions = Array.from(parentSelect.options);

            searchInput.addEventListener('input', function() {
                applyFilters();
            });

            if (clearBtn) {
                clearBtn.addEventListener('click', function() {
                    searchInput.value = '';
                    applyFilters();
                    searchInput.focus();
                });
            }

            // Clear search when parent is selected
            parentSelect.addEventListener('change', function() {
                if (this.value) {
                    searchInput.value = '';
                }
            });
        }

        // Parent Selection Mode Toggle
        function setupParentSelectionToggle() {
            const dropdownMode = document.getElementById('dropdownMode');
            const treeMode = document.getElementById('treeMode');
            const dropdownContainer = document.getElementById('dropdownSelectionContainer');
            const treeContainer = document.getElementById('treeSelectionContainer');

            if (!dropdownMode || !treeMode) return;

            dropdownMode.addEventListener('change', function() {
                if (this.checked) {
                    dropdownContainer.classList.remove('d-none');
                    treeContainer.classList.add('d-none');
                    // Clear tree selection
                    clearTreeSelection();
                }
            });

            treeMode.addEventListener('change', function() {
                if (this.checked) {
                    dropdownContainer.classList.add('d-none');
                    treeContainer.classList.remove('d-none');
                    // Clear dropdown selection
                    clearDropdownSelection();
                    // Build tree if not already built
                    if (!window.treeBuilt) {
                        buildFamilyTree();
                    }
                }
            });
        }

        // Family Tree Functionality
        function setupFamilyTree() {
            const expandAllBtn = document.getElementById('expandAllTreeBtn');

            if (expandAllBtn) {
                expandAllBtn.addEventListener('click', function() {
                    toggleAllTreeNodes();
                });
            }
        }

        function buildFamilyTree() {
            const container = document.getElementById('familyTreeContainer');
            if (!container || !window.familyTreeData) return;

            const treeData = window.familyTreeData;
            if (!treeData || treeData.length === 0) {
                container.innerHTML = '<div class="text-center text-muted py-4"><i class="fas fa-info-circle me-2"></i>لا توجد أفراد في العائلة حالياً</div>';
                return;
            }

            // Debug: Log the tree data to console
            console.log('Family Tree Data:', treeData);

            // Build tree structure
            const treeStructure = buildTreeStructure(treeData);
            console.log('Tree Structure:', treeStructure);

            const treeHTML = renderTree(treeStructure);

            container.innerHTML = treeHTML;
            window.treeBuilt = true;

            // Setup click handlers
            setupTreeClickHandlers();
        }

        function buildTreeStructure(data) {
            // Create a completely new structure to avoid any reference issues
            const nodeMap = new Map();
            const roots = [];

            // First pass: create all nodes
            for (let i = 0; i < data.length; i++) {
                const person = data[i];
                const node = createPersonNode(person);
                nodeMap.set(person.Id, node);

                console.log(`Created node ${i}: ID=${person.Id}, Name="${person.name}" -> Node Name="${node.name}"`);
            }

            // Second pass: build hierarchy
            for (let i = 0; i < data.length; i++) {
                const person = data[i];
                const currentNode = nodeMap.get(person.Id);

                console.log(`Building hierarchy for: ID=${person.Id}, Name="${currentNode.name}", ParentID=${person.Parent}`);

                if (person.Parent && nodeMap.has(person.Parent)) {
                    const parentNode = nodeMap.get(person.Parent);
                    parentNode.children.push(currentNode);
                    console.log(`Added ${currentNode.name} as child of ${parentNode.name}`);
                } else {
                    roots.push(currentNode);
                    console.log(`Added ${currentNode.name} as root`);
                }
            }

            return roots;
        }

        function createPersonNode(person) {
            return {
                Id: person.Id,
                name: person.name,
                title: person.title,
                Country: person.Country,
                image: person.image,
                Generation: person.Generation,
                Parent: person.Parent,
                children: []
            };
        }

        function renderTree(nodes, level = 0) {
            if (!nodes || nodes.length === 0) return '';

            // Sort nodes by Generation, then by name for consistent display
            const sortedNodes = [...nodes].sort((a, b) => {
                if (a.Generation !== b.Generation) {
                    return a.Generation - b.Generation;
                }
                return (a.name || '').localeCompare(b.name || '', 'ar', {numeric: true});
            });

            let html = '<ul class="tree-level tree-level-' + level + '">';

            sortedNodes.forEach(node => {
                const hasChildren = node.children && node.children.length > 0;
                const nodeClass = 'tree-node' + (hasChildren ? ' has-children' : '');

                // Debug: Log each node being rendered
                console.log('Rendering node:', {
                    id: node.Id,
                    name: node.name,
                    title: node.title,
                    generation: node.Generation,
                    parent: node.Parent,
                    hasChildren: hasChildren
                });

                html += `
                    <li class="${nodeClass}" data-person-id="${node.Id}">
                        <div class="tree-node-content" data-person-id="${node.Id}">
                            <div class="node-toggle ${hasChildren ? '' : 'invisible'}">
                                <i class="fas fa-chevron-down"></i>
                            </div>
                            <div class="node-avatar">
                                ${node.image ?
                                    `<img src="${node.image}" alt="${node.name}">` :
                                    '<i class="fas fa-user"></i>'
                                }
                            </div>
                            <div class="node-info">
                                <div class="node-name">${node.name}</div>
                                <div class="node-details">
                                    ${node.title || 'بدون لقب'} • الجيل ${node.Generation}
                                </div>
                            </div>
                            <div class="node-select-btn">
                                <i class="fas fa-check-circle"></i>
                            </div>
                        </div>
                        ${hasChildren ? renderTree(node.children, level + 1) : ''}
                    </li>
                `;
            });

            html += '</ul>';
            return html;
        }

        function setupTreeClickHandlers() {
            const container = document.getElementById('familyTreeContainer');

            // Toggle nodes
            container.addEventListener('click', function(e) {
                if (e.target.closest('.node-toggle')) {
                    e.preventDefault();
                    e.stopPropagation();
                    const node = e.target.closest('.tree-node');
                    toggleTreeNode(node);
                }
            });

            // Select parent
            container.addEventListener('click', function(e) {
                const nodeContent = e.target.closest('.tree-node-content');
                if (nodeContent && !e.target.closest('.node-toggle')) {
                    e.preventDefault();
                    e.stopPropagation();
                    const personId = nodeContent.dataset.personId;
                    selectParentFromTree(personId, nodeContent);
                }
            });
        }

        function toggleTreeNode(node) {
            const childList = node.querySelector('ul.tree-level');
            const toggle = node.querySelector('.node-toggle i');

            if (childList) {
                if (childList.style.display === 'none') {
                    childList.style.display = '';
                    toggle.className = 'fas fa-chevron-down';
                    node.classList.remove('collapsed');
                } else {
                    childList.style.display = 'none';
                    toggle.className = 'fas fa-chevron-right';
                    node.classList.add('collapsed');
                }
            }
        }

        function toggleAllTreeNodes() {
            const container = document.getElementById('familyTreeContainer');
            const expandAllBtn = document.getElementById('expandAllTreeBtn');
            const allNodes = container.querySelectorAll('.tree-node.has-children');

            const isExpanded = Array.from(allNodes).some(node =>
                !node.classList.contains('collapsed')
            );

            allNodes.forEach(node => {
                const childList = node.querySelector('ul.tree-level');
                const toggle = node.querySelector('.node-toggle i');

                if (childList) {
                    if (isExpanded) {
                        // Collapse all
                        childList.style.display = 'none';
                        toggle.className = 'fas fa-chevron-right';
                        node.classList.add('collapsed');
                    } else {
                        // Expand all
                        childList.style.display = '';
                        toggle.className = 'fas fa-chevron-down';
                        node.classList.remove('collapsed');
                    }
                }
            });

            // Update button text
            expandAllBtn.innerHTML = isExpanded ?
                '<i class="fas fa-expand-arrows-alt me-1"></i>توسيع الكل' :
                '<i class="fas fa-compress-arrows-alt me-1"></i>طي الكل';
        }

        function selectParentFromTree(personId, nodeElement) {
            // Clear previous selection
            document.querySelectorAll('.tree-node-content.selected').forEach(node => {
                node.classList.remove('selected');
            });

            // Select current node
            nodeElement.classList.add('selected');

            // Update hidden input
            const hiddenInput = document.getElementById('selectedParentFromTree');
            if (hiddenInput) {
                hiddenInput.value = personId;
            }

            // Find person data
            const personData = window.familyTreeData.find(p => p.Id == personId);
            if (personData) {
                // Show selection feedback
                showTreeSelectionFeedback(personData);
            }
        }

        function showTreeSelectionFeedback(person) {
            // Create or update feedback element
            let feedback = document.getElementById('treeSelectionFeedback');
            if (!feedback) {
                feedback = document.createElement('div');
                feedback.id = 'treeSelectionFeedback';
                feedback.className = 'tree-selection-feedback mt-3';
                document.getElementById('treeSelectionContainer').appendChild(feedback);
            }

            const hierarchyText = person.Parent ?
                `ابن/ابنة ${getParentName(person.Parent)}` :
                '(الجد الأعلى)';

            feedback.innerHTML = `
                <div class="selected-parent-card">
                    <div class="parent-info">
                        <div class="parent-avatar">
                            ${person.image ?
                                `<img src="${person.image}" alt="${person.name}">` :
                                '<i class="fas fa-user"></i>'
                            }
                        </div>
                        <div class="parent-details">
                            <h6>
                                ${person.name} ${hierarchyText}
                            </h6>
                            <p class="mb-0">
                                ${person.title || 'بدون لقب'} - الجيل ${person.Generation}
                            </p>
                        </div>
                        <div class="selection-badge">
                            <i class="fas fa-check-circle text-success"></i>
                        </div>
                    </div>
                </div>
            `;
        }

        function getParentName(parentId) {
            const parent = window.familyTreeData.find(p => p.Id == parentId);
            return parent ? parent.name : 'غير معروف';
        }

        function clearTreeSelection() {
            document.querySelectorAll('.tree-node-content.selected').forEach(node => {
                node.classList.remove('selected');
            });

            const hiddenInput = document.getElementById('selectedParentFromTree');
            if (hiddenInput) {
                hiddenInput.value = '';
            }

            const feedback = document.getElementById('treeSelectionFeedback');
            if (feedback) {
                feedback.remove();
            }
        }

        function clearDropdownSelection() {
            const parentSelect = document.getElementById('parentSelect');
            const searchInput = document.getElementById('parentSearchInput');

            if (parentSelect) {
                parentSelect.value = '';
            }
            if (searchInput) {
                searchInput.value = '';
                applyFilters();
            }
            hideParentPreview();
        }
    </script>

