@model IEnumerable<SukkarFamily.Models.Persone>
@{
    ViewData["Title"] = "أفراد العائلة";
    Layout = "~/Views/Shared/_LayoutArabic.cshtml";
}

<div class="family-members-page">
    <!-- Page Header -->
    <div class="page-header-islamic fade-in-up">
        <div class="container-fluid">
            <div class="row align-items-center">
                <div class="col-lg-8">
                    <div class="page-title-section">
                        <div class="islamic-decoration mb-3">
                            <i class="fas fa-star-and-crescent text-gold"></i>
                        </div>
                        <h1 class="page-title">
                            <i class="fas fa-users text-gold me-3"></i>
                            أفراد عائلة سكر الكرام
                        </h1>
                        <p class="page-subtitle">سجل شامل لجميع أفراد العائلة المباركة عبر الأجيال</p>
                        <div class="breadcrumb-islamic">
                            <a href="@Url.Action("Index", "Home")"><i class="fas fa-home"></i> الرئيسية</a>
                            <span class="separator"><i class="fas fa-angle-left"></i></span>
                            <span class="current">أفراد العائلة</span>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="page-actions">
                        <a href="@Url.Action("Create", "Persone")" class="btn btn-gold btn-lg mb-2">
                            <i class="fas fa-user-plus me-2"></i>إضافة فرد جديد
                        </a>
                        <a href="@Url.Action("Tree", "Persone")" class="btn btn-outline-light btn-lg">
                            <i class="fas fa-sitemap me-2"></i>عرض شجرة العائلة
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="statistics-section mb-5 fade-in-up">
        <div class="container-fluid">
            <div class="row g-4">
                <div class="col-xl-3 col-lg-6 col-md-6">
                    <div class="stat-card-islamic">
                        <div class="stat-icon-wrapper">
                            <div class="stat-icon">
                                <i class="fas fa-users"></i>
                            </div>
                        </div>
                        <div class="stat-content">
                            <h3 class="stat-number">@Model.Count()</h3>
                            <p class="stat-label">إجمالي أفراد العائلة</p>
                            <div class="stat-decoration"></div>
                        </div>
                    </div>
                </div>
                <div class="col-xl-3 col-lg-6 col-md-6">
                    <div class="stat-card-islamic">
                        <div class="stat-icon-wrapper">
                            <div class="stat-icon">
                                <i class="fas fa-layer-group"></i>
                            </div>
                        </div>
                        <div class="stat-content">
                            <h3 class="stat-number">@(Model.Any() ? Model.Max(p => p.Generation) : 0)</h3>
                            <p class="stat-label">عدد الأجيال</p>
                            <div class="stat-decoration"></div>
                        </div>
                    </div>
                </div>
                <div class="col-xl-3 col-lg-6 col-md-6">
                    <div class="stat-card-islamic">
                        <div class="stat-icon-wrapper">
                            <div class="stat-icon">
                                <i class="fas fa-calendar-alt"></i>
                            </div>
                        </div>
                        <div class="stat-content">
                            <h3 class="stat-number">@Model.Count(p => p.DateOfBirth.HasValue)</h3>
                            <p class="stat-label">تواريخ الميلاد المسجلة</p>
                            <div class="stat-decoration"></div>
                        </div>
                    </div>
                </div>
                <div class="col-xl-3 col-lg-6 col-md-6">
                    <div class="stat-card-islamic">
                        <div class="stat-icon-wrapper">
                            <div class="stat-icon">
                                <i class="fas fa-heart"></i>
                            </div>
                        </div>
                        <div class="stat-content">
                            <h3 class="stat-number">@Model.Count(p => !p.DateOfDeath.HasValue)</h3>
                            <p class="stat-label">على قيد الحياة</p>
                            <div class="stat-decoration"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Success/Error Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mx-3" role="alert">
            <i class="fas fa-check-circle me-2"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mx-3" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Search and Filter -->
    <div class="search-filter-section mb-5 fade-in-up">
        <div class="card-islamic">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="fas fa-filter me-2"></i>
                    البحث والتصفية
                </h5>
            </div>
            <div class="card-body">
                <div class="row g-3 align-items-end">
                    <div class="col-lg-4 col-md-6">
                        <label class="form-label text-muted fw-bold">
                            <i class="fas fa-search me-2 text-gold"></i>البحث
                        </label>
                        <div class="search-box-islamic">
                            <input type="text" id="searchInput" class="form-control form-control-lg" placeholder="البحث بالاسم أو اللقب...">
                            <i class="fas fa-search search-icon"></i>
                        </div>
                    </div>
                    <div class="col-lg-2 col-md-6">
                        <label class="form-label text-muted fw-bold">
                            <i class="fas fa-layer-group me-2 text-gold"></i>الجيل
                        </label>
                        <select id="generationFilter" class="form-select form-select-lg">
                            <option value="">جميع الأجيال</option>
                            @for (int i = 1; i <= (Model.Any() ? Model.Max(p => p.Generation) : 1); i++)
                            {
                                <option value="@i">الجيل @i</option>
                            }
                        </select>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label text-muted fw-bold">
                            <i class="fas fa-sort me-2 text-gold"></i>ترتيب حسب
                        </label>
                        <select id="sortBy" class="form-select form-select-lg">
                            <option value="generation" selected>الجيل ثم تاريخ الميلاد</option>
                            <option value="name">الاسم أبجدياً</option>
                            <option value="birth">تاريخ الميلاد</option>
                        </select>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label text-muted fw-bold">
                            <i class="fas fa-eye me-2 text-gold"></i>طريقة العرض
                        </label>
                        <div class="view-toggle-group">
                            <button type="button" class="btn btn-outline-islamic" id="gridView" title="عرض شبكي">
                                <i class="fas fa-th me-2"></i>شبكي
                            </button>
                            <button type="button" class="btn btn-islamic active" id="listView" title="عرض قائمة">
                                <i class="fas fa-list me-2"></i>قائمة
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Family Members Content -->
    <div id="membersContent">
        @if (Model != null && Model.Any())
        {
            <!-- List View (Default) -->
            <div id="listViewContent" class="fade-in-up">
                <div class="card-islamic">
                    <div class="card-header">
                        <div class="d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">
                                <i class="fas fa-list me-2"></i>قائمة أفراد العائلة المباركة
                            </h5>
                            <span class="badge bg-light text-dark fs-6">
                                <i class="fas fa-users me-1"></i>@Model.Count() فرد
                            </span>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover members-table-islamic mb-0">
                                <thead class="table-header-islamic">
                                    <tr>
                                        <th class="text-center" width="70">
                                            <i class="fas fa-hashtag"></i>
                                        </th>
                                        <th class="text-center" width="80">
                                            <i class="fas fa-image"></i>
                                        </th>
                                        <th>
                                            <i class="fas fa-user me-2"></i>الاسم الكريم
                                        </th>
                                        <th>
                                            <i class="fas fa-crown me-2"></i>اللقب
                                        </th>
                                        <th>
                                            <i class="fas fa-flag me-2"></i>البلد
                                        </th>
                                        <th class="text-center">
                                            <i class="fas fa-birthday-cake me-2"></i>الميلاد
                                        </th>
                                        <th class="text-center">
                                            <i class="fas fa-mosque me-2"></i>الوفاة
                                        </th>
                                        <th>
                                            <i class="fas fa-user-tie me-2"></i>الوالد
                                        </th>
                                        <th class="text-center">
                                            <i class="fas fa-layer-group me-2"></i>الجيل
                                        </th>
                                        <th class="text-center" width="200">
                                            <i class="fas fa-cogs me-2"></i>الإجراءات
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var person in Model.OrderBy(p => p.Generation).ThenBy(p => p.Parent?.name ?? "").ThenBy(p => p.DateOfBirth ?? DateTime.MaxValue).ThenBy(p => p.name))
                                    {
                                        <tr class="member-row-islamic" data-name="@person.name" data-title="@person.title" data-generation="@person.Generation">
                                            <td class="text-center">
                                                <span class="member-id-badge">@person.Id</span>
                                            </td>
                                            <td class="text-center">
                                                <div class="member-avatar-islamic">
                                                    @if (!string.IsNullOrEmpty(person.image))
                                                    {
                                                        <img src="@person.image" alt="@person.name" class="avatar-img-islamic">
                                                    }
                                                    else
                                                    {
                                                        <div class="avatar-placeholder-islamic">
                                                            <i class="fas fa-user"></i>
                                                        </div>
                                                    }
                                                </div>
                                            </td>
                                            <td>
                                                <div class="member-name-section">
                                                    <div class="member-name-primary">@person.name</div>
                                                    @if (person.Generation == 1)
                                                    {
                                                        <span class="ancestor-badge">
                                                            <i class="fas fa-crown me-1"></i>الجد الأعلى
                                                        </span>
                                                    }
                                                </div>
                                            </td>
                                            <td>
                                                <span class="member-title-text">@(person.title ?? "غير محدد")</span>
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(person.Country))
                                                {
                                                    <span class="country-badge-islamic">
                                                        <i class="fas fa-map-marker-alt me-1"></i>@person.Country
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted-islamic">غير محدد</span>
                                                }
                                            </td>
                                            <td class="text-center">
                                                @if (person.DateOfBirth.HasValue)
                                                {
                                                    <div class="date-info-islamic birth-info">
                                                        <div class="date-value">@person.DateOfBirth.Value.ToString("yyyy/MM/dd")</div>
                                                        <div class="date-label">الميلاد</div>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span class="text-muted-islamic">غير محدد</span>
                                                }
                                            </td>
                                            <td class="text-center">
                                                @if (person.DateOfDeath.HasValue)
                                                {
                                                    <div class="date-info-islamic death-info">
                                                        <div class="date-value">@person.DateOfDeath.Value.ToString("yyyy/MM/dd")</div>
                                                        <div class="date-label">الوفاة</div>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span class="alive-badge">
                                                        <i class="fas fa-heart me-1"></i>على قيد الحياة
                                                    </span>
                                                }
                                            </td>
                                            <td>
                                                @if (person.Parent != null)
                                                {
                                                    <a href="@Url.Action("Details", new { id = person.Parent.Id })" class="parent-link-islamic">
                                                        <i class="fas fa-user-tie me-1"></i>@person.Parent.name
                                                    </a>
                                                }
                                                else
                                                {
                                                    <span class="root-indicator">
                                                        <i class="fas fa-tree me-1"></i>الجد الأعلى
                                                    </span>
                                                }
                                            </td>
                                            <td class="text-center">
                                                <span class="generation-badge-islamic generation-@person.Generation">
                                                    <span class="generation-number">@person.Generation</span>
                                                    <span class="generation-label">الجيل</span>
                                                </span>
                                            </td>
                                            <td class="text-center">
                                                <div class="action-buttons-islamic">
                                                    <a href="@Url.Action("Edit", new { id = person.Id })" class="btn btn-sm btn-islamic-warning" title="تعديل البيانات">
                                                        <i class="fas fa-edit"></i>
                                                    </a>
                                                    <a href="@Url.Action("Create", new { id = person.Id })" class="btn btn-sm btn-islamic-success" title="إضافة أطفال">
                                                        <i class="fas fa-user-plus"></i>
                                                    </a>
                                                    <button type="button" class="btn btn-sm btn-islamic-danger" onclick="confirmDelete(@person.Id, '@person.name')" title="حذف">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Grid View -->
            <div id="gridViewContent" class="d-none">
                <div class="row g-4">
                    @foreach (var person in Model.OrderBy(p => p.Generation).ThenBy(p => p.Parent?.name ?? "").ThenBy(p => p.DateOfBirth ?? DateTime.MaxValue).ThenBy(p => p.name))
                    {
                        <div class="col-xl-3 col-lg-4 col-md-6 member-card-container-islamic" data-name="@person.name" data-title="@person.title" data-generation="@person.Generation">
                            <div class="member-card-islamic fade-in-up">
                                <div class="member-card-header-islamic">
                                    <div class="member-photo-section">
                                        @if (!string.IsNullOrEmpty(person.image))
                                        {
                                            <img src="@person.image" alt="@person.name" class="member-photo-islamic">
                                        }
                                        else
                                        {
                                            <div class="member-photo-placeholder-islamic">
                                                <i class="fas fa-user"></i>
                                            </div>
                                        }
                                    </div>
                                    <div class="generation-indicator-islamic generation-@person.Generation">
                                        <span class="generation-number">@person.Generation</span>
                                    </div>
                                    @if (person.Generation == 1)
                                    {
                                        <div class="ancestor-crown">
                                            <i class="fas fa-crown"></i>
                                        </div>
                                    }
                                </div>
                                <div class="member-card-body-islamic">
                                    <h5 class="member-name-islamic">@person.name</h5>
                                    @if (!string.IsNullOrEmpty(person.title))
                                    {
                                        <p class="member-title-islamic">@person.title</p>
                                    }

                                    <div class="member-details-islamic">
                                        @if (!string.IsNullOrEmpty(person.Country))
                                        {
                                            <div class="detail-item">
                                                <i class="fas fa-map-marker-alt"></i>
                                                <span>@person.Country</span>
                                            </div>
                                        }
                                        @if (person.DateOfBirth.HasValue)
                                        {
                                            <div class="detail-item birth-detail">
                                                <i class="fas fa-birthday-cake"></i>
                                                <span>@person.DateOfBirth.Value.ToString("yyyy")</span>
                                            </div>
                                        }
                                        @if (person.DateOfDeath.HasValue)
                                        {
                                            <div class="detail-item death-detail">
                                                <i class="fas fa-mosque"></i>
                                                <span>@person.DateOfDeath.Value.ToString("yyyy")</span>
                                            </div>
                                        }
                                        else if (person.DateOfBirth.HasValue)
                                        {
                                            <div class="detail-item alive-detail">
                                                <i class="fas fa-heart"></i>
                                                <span>على قيد الحياة</span>
                                            </div>
                                        }
                                        @if (person.Parent != null)
                                        {
                                            <div class="detail-item parent-detail">
                                                <i class="fas fa-user-tie"></i>
                                                <span>@person.Parent.name</span>
                                            </div>
                                        }
                                    </div>

                                    <div class="member-actions-islamic">
                                        <a href="@Url.Action("Edit", new { id = person.Id })" class="btn btn-islamic-action" title="تعديل">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a href="@Url.Action("Create", new { id = person.Id })" class="btn btn-islamic-action" title="إضافة أطفال">
                                            <i class="fas fa-user-plus"></i>
                                        </a>
                                        <button type="button" class="btn btn-islamic-action btn-danger-action" onclick="confirmDelete(@person.Id, '@person.name')" title="حذف">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            <!-- Empty State -->
            <div class="empty-state text-center py-5 fade-in-up">
                <div class="card-islamic">
                    <div class="card-body py-5">
                        <i class="fas fa-users text-muted mb-4" style="font-size: 4rem;"></i>
                        <h3 class="text-muted mb-3">لا يوجد أفراد في العائلة</h3>
                        <p class="text-muted mb-4">ابدأ بإضافة الجد الأعلى لعائلة سكر</p>
                        <a href="@Url.Action("Create", "Persone")" class="btn btn-gold btn-lg">
                            <i class="fas fa-user-plus me-2"></i>إضافة أول فرد
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteModalLabel">
                    <i class="fas fa-exclamation-triangle me-2"></i>تأكيد الحذف
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center">
                <i class="fas fa-user-times text-danger mb-3" style="font-size: 3rem;"></i>
                <h4>حذف فرد من العائلة</h4>
                <p id="deletePersonName" class="text-muted"></p>
                <div class="alert alert-warning">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    تحذير: سيتم حذف جميع الأطفال المرتبطين بهذا الشخص
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-arrow-left me-2"></i>إلغاء
                </button>
                <button type="button" class="btn btn-danger" id="confirmDeleteBtn">
                    <i class="fas fa-trash me-2"></i>حذف نهائي
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Html.AntiForgeryToken()
    <script>
        let personIdToDelete = null;

        // Delete confirmation
        function confirmDelete(personId, personName) {
            personIdToDelete = personId;
            document.getElementById('deletePersonName').textContent = `هل أنت متأكد من حذف "${personName}"؟`;
            const deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));
            deleteModal.show();
        }

        document.getElementById('confirmDeleteBtn').addEventListener('click', function() {
            if (personIdToDelete) {
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = '@Url.Action("Delete", "Persone")/' + personIdToDelete;

                // Get the anti-forgery token
                const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
                if (tokenInput) {
                    const token = document.createElement('input');
                    token.type = 'hidden';
                    token.name = '__RequestVerificationToken';
                    token.value = tokenInput.value;
                    form.appendChild(token);
                }

                document.body.appendChild(form);
                form.submit();
            }
        });

        // Search functionality
        document.getElementById('searchInput').addEventListener('input', function() {
            const searchTerm = this.value.toLowerCase();
            filterMembers();
        });

        // Generation filter
        document.getElementById('generationFilter').addEventListener('change', function() {
            filterMembers();
        });

        // Sort functionality
        document.getElementById('sortBy').addEventListener('change', function() {
            sortMembers(this.value);
        });

        // View toggle
        document.getElementById('gridView').addEventListener('click', function() {
            showGridView();
        });

        document.getElementById('listView').addEventListener('click', function() {
            showListView();
        });

        function filterMembers() {
            const searchTerm = document.getElementById('searchInput').value.toLowerCase();
            const selectedGeneration = document.getElementById('generationFilter').value;

            const listRows = document.querySelectorAll('.member-row-islamic');
            const gridCards = document.querySelectorAll('.member-card-container-islamic');

            const filterRow = (element, isGrid = false) => {
                const name = element.dataset.name?.toLowerCase() || '';
                const title = element.dataset.title?.toLowerCase() || '';
                const generation = element.dataset.generation;

                const matchesSearch = !searchTerm || name.includes(searchTerm) || title.includes(searchTerm);
                const matchesGeneration = !selectedGeneration || generation === selectedGeneration;

                if (matchesSearch && matchesGeneration) {
                    element.style.display = '';
                } else {
                    element.style.display = 'none';
                }
            };

            listRows.forEach(row => filterRow(row));
            gridCards.forEach(card => filterRow(card, true));

            // Reapply dynamic generation colors after filtering
            applyDynamicGenerationColors();
        }

        function sortMembers(sortBy) {
            // This would require server-side implementation for full sorting
            console.log('ترتيب حسب:', sortBy);
        }

        function showGridView() {
            document.getElementById('listViewContent').classList.add('d-none');
            document.getElementById('gridViewContent').classList.remove('d-none');
            document.getElementById('listView').classList.remove('active');
            document.getElementById('gridView').classList.add('active');

            // Update button styles
            document.getElementById('listView').classList.remove('btn-islamic');
            document.getElementById('listView').classList.add('btn-outline-islamic');
            document.getElementById('gridView').classList.remove('btn-outline-islamic');
            document.getElementById('gridView').classList.add('btn-islamic');

            // Reapply dynamic colors when switching views
            setTimeout(applyDynamicGenerationColors, 50);
        }

        function showListView() {
            document.getElementById('gridViewContent').classList.add('d-none');
            document.getElementById('listViewContent').classList.remove('d-none');
            document.getElementById('gridView').classList.remove('active');
            document.getElementById('listView').classList.add('active');

            // Update button styles
            document.getElementById('gridView').classList.remove('btn-islamic');
            document.getElementById('gridView').classList.add('btn-outline-islamic');
            document.getElementById('listView').classList.remove('btn-outline-islamic');
            document.getElementById('listView').classList.add('btn-islamic');

            // Reapply dynamic colors when switching views
            setTimeout(applyDynamicGenerationColors, 50);
        }

        // Generate dynamic colors for generations > 10
        function generateGenerationColor(generation) {
            // Predefined colors for generations 1-10 are handled by CSS
            if (generation <= 10) return null;

            // Generate color using HSL for consistent, vibrant colors
            const hue = ((generation - 11) * 137.5) % 360; // Golden ratio * 360 for good distribution
            const saturation = 70 + (generation % 3) * 10; // 70-90% saturation for vibrant colors
            const lightness = 45 + (generation % 2) * 10;  // 45-55% lightness for good contrast

            return `hsl(${hue}, ${saturation}%, ${lightness}%)`;
        }

        // Apply dynamic generation colors
        function applyDynamicGenerationColors() {
            // Get all generation badges and indicators
            const generationElements = document.querySelectorAll('.generation-badge-islamic, .generation-indicator-islamic');

            generationElements.forEach(element => {
                // Extract generation number from class
                const classList = Array.from(element.classList);
                const generationClass = classList.find(cls => cls.startsWith('generation-'));

                if (generationClass) {
                    const generation = parseInt(generationClass.replace('generation-', ''));

                    // Apply dynamic color for generations > 10
                    if (generation > 10) {
                        const color = generateGenerationColor(generation);
                        element.style.background = color;
                        element.style.color = 'white';

                        // Ensure good contrast for yellow-ish colors
                        const hsl = color.match(/hsl\((\d+),/);
                        if (hsl && (parseInt(hsl[1]) > 50 && parseInt(hsl[1]) < 70)) {
                            element.style.color = '#000';
                        }
                    }
                }
            });
        }

        // Initialize tooltips and apply dynamic colors
        document.addEventListener('DOMContentLoaded', function() {
            const tooltipTriggerList = [].slice.call(document.querySelectorAll('[title]'));
            tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });

            // Apply dynamic generation colors
            applyDynamicGenerationColors();
        });
    </script>

