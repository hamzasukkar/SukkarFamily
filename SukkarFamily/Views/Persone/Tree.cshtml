@{
    ViewData["Title"] = "شجرة العائلة";
    Layout = "~/Views/Shared/_LayoutArabic.cshtml";
}

<!-- Enhanced Family Tree Styles -->
<link rel="stylesheet" href="~/css/family-tree-arabic.css">
<link rel="stylesheet" href="~/css/jquery.orgchart.css">

<div class="family-tree-page">
    <div class="tree-header fade-in-up">
        <i class="fas fa-star-and-crescent text-gold mb-3" style="font-size: 3rem;"></i>
        <h1 class="arabic-title">شجرة عائلة سكر الكريمة</h1>
        <p class="lead">النسب الشريف المتصل بآل البيت النبوي الكريم</p>
        <div class="islamic-divider"></div>
    </div>

    <!-- Genealogy Info -->
    <div class="row mb-5 fade-in-up-delay">
        <div class="col-lg-6 mb-4">
            <div class="card-islamic">
                <div class="card-header">
                    <h5><i class="fas fa-scroll"></i>النسب الشريف</h5>
                </div>
                <div class="card-body">
                    <div class="arabic-text">
                        <p><strong class="text-gold">الجد الأعلى:</strong> السيّد حسن الملقّب بالسكر</p>
                        <p><strong class="text-gold">النسب:</strong> ابن السيّد شرف الدين قباد بن مصطفى الأمير ابن شرف الدين موسى بن إبراهيم شيخ ابريك</p>
                        <p><strong class="text-gold">الاتصال:</strong> يتصل النسب بالقطب عز الدين أحمد الصيادي سبط الحضرة الرفاعية الحسيني</p>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-6 mb-4">
            <div class="card-islamic">
                <div class="card-header">
                    <h5><i class="fas fa-home"></i>المواطن والأماكن</h5>
                </div>
                <div class="card-body">
                    <div class="locations-grid">
                        <div class="location-item">
                            <i class="fas fa-map-marker-alt text-gold"></i>
                            <span>دمشق - الصالحية</span>
                        </div>
                        <div class="location-item">
                            <i class="fas fa-map-marker-alt text-gold"></i>
                            <span>دمشق - الميدان</span>
                        </div>
                        <div class="location-item">
                            <i class="fas fa-map-marker-alt text-gold"></i>
                            <span>بيروت المحروسة</span>
                        </div>
                        <div class="location-item">
                            <i class="fas fa-map-marker-alt text-gold"></i>
                            <span>بعلبك</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tree Controls -->
    <div class="tree-controls mb-4 fade-in-up">
        <div class="row">
            <div class="col-md-8">
                <div class="btn-group" role="group">
                    <button type="button" class="btn btn-gold" id="expandAll">
                        <i class="fas fa-expand-arrows-alt me-2"></i>توسيع الكل
                    </button>
                    <button type="button" class="btn btn-outline-secondary" id="collapseAll">
                        <i class="fas fa-compress-arrows-alt me-2"></i>طي الكل
                    </button>
                    <button type="button" class="btn btn-outline-secondary" id="centerTree">
                        <i class="fas fa-crosshairs me-2"></i>توسيط الشجرة
                    </button>
                </div>
            </div>
            <div class="col-md-4 text-md-end">
                <div class="btn-group" role="group">
                    <button type="button" class="btn btn-outline-secondary" id="zoomIn">
                        <i class="fas fa-search-plus"></i>
                    </button>
                    <button type="button" class="btn btn-outline-secondary" id="zoomOut">
                        <i class="fas fa-search-minus"></i>
                    </button>
                    <button type="button" class="btn btn-outline-secondary" id="fullscreen">
                        <i class="fas fa-expand"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Loading Spinner -->
    <div id="loadingSpinner" class="text-center py-5">
        <div class="loading-spinner mb-3"></div>
        <p class="text-muted">جاري تحميل شجرة العائلة...</p>
    </div>

    <!-- Tree Container -->
    <div class="family-tree-container fade-in-up">
        <div id="chart-container" class="arabic-tree"></div>
    </div>

    <!-- Tree Legend -->
    <div class="tree-legend mt-4 fade-in-up">
        <div class="card-islamic">
            <div class="card-header">
                <h5><i class="fas fa-info-circle"></i>دليل الرموز</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-3 mb-2">
                        <span class="legend-item">
                            <i class="fas fa-male text-primary me-2"></i>الذكور
                        </span>
                    </div>
                    <div class="col-md-3 mb-2">
                        <span class="legend-item">
                            <i class="fas fa-female text-pink me-2"></i>الإناث
                        </span>
                    </div>
                    <div class="col-md-3 mb-2">
                        <span class="legend-item">
                            <i class="fas fa-crown text-gold me-2"></i>رؤساء الأجيال
                        </span>
                    </div>
                    <div class="col-md-3 mb-2">
                        <span class="legend-item">
                            <i class="fas fa-star text-success me-2"></i>أحياء
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/jquery.orgchart.js"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            let chart;
            
            // Show loading spinner
            $('#loadingSpinner').show();
            $('#chart-container').hide();
            
            // Fetch tree data
            $.get("/Persone/Root")
                .done(function (data) {
                    if (data && data.name) {
                        initializeTree(data);
                    } else {
                        showError('لا توجد بيانات للشجرة');
                    }
                })
                .fail(function () {
                    showError('حدث خطأ في تحميل بيانات الشجرة');
                })
                .always(function () {
                    $('#loadingSpinner').hide();
                });

            function initializeTree(data) {
                // Enhanced tree configuration for Arabic family tree
                chart = $('#chart-container').orgchart({
                    'data': data,
                    'nodeContent': 'title',
                    'direction': 't2b', // Top to bottom - natural family tree flow
                    'toggleSiblingsResp': true,
                    'depth': 3,
                    'nodeId': 'id',
                    'createNode': function($node, data) {
                        // Customize node appearance for Arabic names
                        $node.addClass('arabic-node');
                        
                        // Add gender-specific styling
                        if (data.gender) {
                            $node.addClass(data.gender === 'male' ? 'male-node' : 'female-node');
                        }
                        
                        // Add generation badge
                        if (data.generation) {
                            $node.append(`<div class="generation-badge">الجيل ${data.generation}</div>`);
                        }
                        
                        // Add status indicator
                        if (data.isAlive) {
                            $node.append('<i class="status-icon fas fa-circle text-success"></i>');
                        }
                        
                        // Make nodes clickable for details
                        $node.on('click', function() {
                            showPersonDetails(data);
                        });
                    },
                    'exportButton': true,
                    'exportFilename': 'شجرة_عائلة_سكر',
                    'pan': true,
                    'zoom': true
                });
                
                $('#chart-container').show();
                centerTree();
            }

            function showPersonDetails(data) {
                // Create a modal or detailed view for person information
                const modalContent = `
                    <div class="person-details-modal">
                        <h4>${data.name}</h4>
                        <p><strong>اللقب:</strong> ${data.title || 'غير محدد'}</p>
                        <p><strong>الجيل:</strong> ${data.generation || 'غير محدد'}</p>
                        ${data.image ? `<img src="${data.image}" class="person-image" alt="${data.name}">` : ''}
                    </div>
                `;
                
                // You can implement a proper modal here
                alert(`تفاصيل: ${data.name}\nاللقب: ${data.title || 'غير محدد'}`);
            }

            function showError(message) {
                $('#chart-container').html(`
                    <div class="alert alert-islamic-error text-center">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        ${message}
                    </div>
                `).show();
            }

            function centerTree() {
                if (chart) {
                    chart.find('.orgchart').css({
                        'transform': 'translate(-50%, 20px) scale(1)',
                        'transform-origin': 'center top'
                    });
                }
            }

            // Tree control handlers
            $('#expandAll').on('click', function () {
                $('#chart-container').find('.node').removeClass('collapsed');
                $('#chart-container').find('.hidden').removeClass('hidden');
            });

            $('#collapseAll').on('click', function () {
                $('#chart-container').find('.node:not(.root)').addClass('collapsed');
            });

            $('#centerTree').on('click', centerTree);

            $('#zoomIn').on('click', function () {
                if (chart) {
                    const currentScale = parseFloat($('#chart-container .orgchart').css('transform').match(/scale\(([^)]+)\)/)?.[1] || 1);
                    const newScale = Math.min(currentScale * 1.2, 3);
                    $('#chart-container .orgchart').css('transform', `translate(-50%, 20px) scale(${newScale})`);
                }
            });

            $('#zoomOut').on('click', function () {
                if (chart) {
                    const currentScale = parseFloat($('#chart-container .orgchart').css('transform').match(/scale\(([^)]+)\)/)?.[1] || 1);
                    const newScale = Math.max(currentScale * 0.8, 0.3);
                    $('#chart-container .orgchart').css('transform', `translate(-50%, 20px) scale(${newScale})`);
                }
            });

            $('#fullscreen').on('click', function () {
                if (document.fullscreenElement) {
                    document.exitFullscreen();
                } else {
                    document.getElementById('chart-container').requestFullscreen();
                }
            });
        });
    </script>
}