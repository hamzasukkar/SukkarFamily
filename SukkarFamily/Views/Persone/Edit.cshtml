@model SukkarFamily.Models.Persone
@{
    ViewData["Title"] = "تعديل بيانات فرد العائلة";
    Layout = "~/Views/Shared/_LayoutArabic.cshtml";
}

<div class="edit-member-page">
    <!-- Page Header -->
    <div class="page-header-islamic fade-in-up">
        <div class="container-fluid">
            <div class="row align-items-center">
                <div class="col-lg-8">
                    <div class="page-title-section">
                        <div class="islamic-decoration mb-3">
                            <i class="fas fa-star-and-crescent text-gold"></i>
                        </div>
                        <h1 class="page-title">
                            <i class="fas fa-user-edit text-gold me-3"></i>
                            تعديل بيانات فرد العائلة
                        </h1>
                        <p class="page-subtitle">تحديث معلومات "@Model.name" في سجل عائلة سكر الكرام</p>
                        <div class="breadcrumb-islamic">
                            <a href="@Url.Action("Index", "Home")"><i class="fas fa-home"></i> الرئيسية</a>
                            <span class="separator"><i class="fas fa-angle-left"></i></span>
                            <a href="@Url.Action("Index", "Persone")"><i class="fas fa-users"></i> أفراد العائلة</a>
                            <span class="separator"><i class="fas fa-angle-left"></i></span>
                            <span class="current">تعديل البيانات</span>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="page-actions">
                        <a href="@Url.Action("Index", "Persone")" class="btn btn-outline-light btn-lg mb-2">
                            <i class="fas fa-arrow-right me-2"></i>العودة للقائمة
                        </a>
                        <a href="@Url.Action("Create", "Persone", new { id = Model.Id })" class="btn btn-gold btn-lg">
                            <i class="fas fa-user-plus me-2"></i>إضافة أطفال
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Success/Error Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mx-3" role="alert">
            <i class="fas fa-check-circle me-2"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mx-3" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Member Info Card -->
    <div class="member-info-section mb-4 fade-in-up">
        <div class="container-fluid">
            <div class="card-islamic">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-info-circle me-2"></i>
                        معلومات الفرد الحالية
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-md-2 text-center">
                            <div class="current-avatar">
                                @if (!string.IsNullOrEmpty(Model.image))
                                {
                                    <img src="@Model.image" alt="@Model.name" class="avatar-large">
                                }
                                else
                                {
                                    <div class="avatar-placeholder-large">
                                        <i class="fas fa-user"></i>
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="col-md-10">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="info-item">
                                        <span class="info-label">الاسم:</span>
                                        <span class="info-value">@Model.name</span>
                                    </div>
                                    <div class="info-item">
                                        <span class="info-label">اللقب:</span>
                                        <span class="info-value">@(Model.title ?? "غير محدد")</span>
                                    </div>
                                    <div class="info-item">
                                        <span class="info-label">البلد:</span>
                                        <span class="info-value">@(Model.Country ?? "غير محدد")</span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="info-item">
                                        <span class="info-label">الجيل:</span>
                                        <span class="generation-badge-small generation-@Model.Generation">الجيل @Model.Generation</span>
                                    </div>
                                    <div class="info-item">
                                        <span class="info-label">تاريخ الميلاد:</span>
                                        <span class="info-value">@(Model.DateOfBirth?.ToString("yyyy/MM/dd") ?? "غير محدد")</span>
                                    </div>
                                    <div class="info-item">
                                        <span class="info-label">الحالة:</span>
                                        @if (Model.DateOfDeath.HasValue)
                                        {
                                            <span class="status-badge death-status">متوفى (@Model.DateOfDeath.Value.ToString("yyyy/MM/dd"))</span>
                                        }
                                        else
                                        {
                                            <span class="status-badge alive-status">على قيد الحياة</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Edit Form -->
    <div class="edit-form-section fade-in-up">
        <div class="container-fluid">
            <div class="row justify-content-center">
                <div class="col-xl-8 col-lg-10">
                    <div class="card-islamic">
                        <div class="card-header">
                            <h5 class="mb-0">
                                <i class="fas fa-edit me-2"></i>
                                تعديل البيانات
                            </h5>
                        </div>
                        <div class="card-body">
                            <form asp-action="Edit" method="post" id="editPersonForm">
                                <div asp-validation-summary="ModelOnly" class="alert alert-islamic-error" role="alert"></div>
                                <input type="hidden" asp-for="Id" />

                                <!-- Personal Information Section -->
                                <div class="form-section">
                                    <h6 class="section-title">
                                        <i class="fas fa-id-card text-gold me-2"></i>
                                        المعلومات الشخصية
                                    </h6>

                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="form-group-islamic mb-4">
                                                <label asp-for="name" class="form-label-islamic required">
                                                    <i class="fas fa-user me-2 text-gold"></i>الاسم الكامل
                                                </label>
                                                <input asp-for="name" class="form-control-islamic" placeholder="أدخل الاسم الكامل بالعربية" required>
                                                <span asp-validation-for="name" class="validation-message"></span>
                                                <div class="form-help">الاسم الكامل للفرد باللغة العربية</div>
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <div class="form-group-islamic mb-4">
                                                <label asp-for="title" class="form-label-islamic">
                                                    <i class="fas fa-crown me-2 text-gold"></i>اللقب أو الكنية
                                                </label>
                                                <input asp-for="title" class="form-control-islamic" placeholder="مثال: أبو محمد، الشيخ، الدكتور">
                                                <span asp-validation-for="title" class="validation-message"></span>
                                                <div class="form-help">اللقب أو الكنية المعروف بها (اختياري)</div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="form-group-islamic mb-4">
                                                <label asp-for="Country" class="form-label-islamic">
                                                    <i class="fas fa-globe me-2 text-gold"></i>البلد
                                                </label>
                                                <input asp-for="Country" class="form-control-islamic" placeholder="مثال: المملكة العربية السعودية">
                                                <span asp-validation-for="Country" class="validation-message"></span>
                                                <div class="form-help">البلد الذي يقيم فيه الفرد (اختياري)</div>
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <div class="form-group-islamic mb-4">
                                                <label asp-for="Generation" class="form-label-islamic">
                                                    <i class="fas fa-layer-group me-2 text-gold"></i>الجيل
                                                </label>
                                                <input asp-for="Generation" type="number" class="form-control-islamic" min="1" readonly>
                                                <span asp-validation-for="Generation" class="validation-message"></span>
                                                <div class="form-help">رقم الجيل (يتم تحديده تلقائياً)</div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-12">
                                            <div class="form-group-islamic mb-4">
                                                <label for="Parent" class="form-label-islamic">
                                                    <i class="fas fa-user-friends me-2 text-gold"></i>الوالد/الوالدة
                                                </label>

                                                <!-- Hidden input for the actual parent value -->
                                                <input type="hidden" name="Parent" id="parentValue" value="@(Model.Parent?.Id.ToString() ?? "")" />

                                                <!-- Searchable dropdown container -->
                                                <div class="searchable-select-container">
                                                    <div class="searchable-select-input-group">
                                                        <input type="text" id="parentSearch" class="form-control-islamic"
                                                               placeholder="ابحث بالاسم أو الرقم التعريفي..."
                                                               value="@(Model.Parent != null ? $"{Model.Parent.name} {(!string.IsNullOrEmpty(Model.Parent.title) ? $"({Model.Parent.title})" : "")} - الجيل {Model.Parent.Generation} - ID: {Model.Parent.Id}" : "")"
                                                               autocomplete="off">
                                                        <button type="button" class="btn btn-outline-secondary" id="clearParent" title="مسح الاختيار">
                                                            <i class="fas fa-times"></i>
                                                        </button>
                                                        <button type="button" class="btn btn-outline-secondary" id="toggleDropdown" title="إظهار/إخفاء القائمة">
                                                            <i class="fas fa-chevron-down"></i>
                                                        </button>
                                                    </div>

                                                    <!-- Dropdown list -->
                                                    <div class="searchable-dropdown" id="parentDropdown">
                                                        <div class="dropdown-option" data-value="" data-id="">
                                                            <span class="option-text">-- اختر الوالد/الوالدة (اختياري) --</span>
                                                        </div>
                                                        @if (ViewBag.GetParents != null)
                                                        {
                                                            @foreach (var parent in (List<SukkarFamily.Models.Persone>)ViewBag.GetParents)
                                                            {
                                                                <div class="dropdown-option @(Model.Parent != null && Model.Parent.Id == parent.Id ? "selected" : "")"
                                                                     data-value="@parent.Id"
                                                                     data-id="@parent.Id"
                                                                     data-name="@parent.name"
                                                                     data-title="@parent.title"
                                                                     data-generation="@parent.Generation">
                                                                    <div class="option-content">
                                                                        <span class="option-name">@parent.name</span>
                                                                        @if (!string.IsNullOrEmpty(parent.title))
                                                                        {
                                                                            <span class="option-title">(@parent.title)</span>
                                                                        }
                                                                        <span class="option-generation">- الجيل @parent.Generation</span>
                                                                        <span class="option-id">- ID: @parent.Id</span>
                                                                    </div>
                                                                </div>
                                                            }
                                                        }
                                                    </div>
                                                </div>

                                                <div class="form-help">ابحث بالاسم أو الرقم التعريفي لاختيار الوالد/الوالدة. سيتم تحديث رقم الجيل تلقائياً. اتركه فارغاً إذا كان هذا الشخص هو جد العائلة.</div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-12">
                                            <div class="form-group-islamic mb-4">
                                                <label asp-for="image" class="form-label-islamic">
                                                    <i class="fas fa-image me-2 text-gold"></i>رابط الصورة الشخصية
                                                </label>
                                                <div class="input-group-islamic">
                                                    <input asp-for="image" class="form-control-islamic" placeholder="https://example.com/image.jpg" id="imageInput">
                                                    <button type="button" class="btn btn-outline-secondary" id="previewBtn">
                                                        <i class="fas fa-eye"></i> معاينة
                                                    </button>
                                                </div>
                                                <span asp-validation-for="image" class="validation-message"></span>
                                                <div class="form-help">رابط صورة شخصية واضحة (اختياري)</div>
                                            </div>

                                            <!-- Image Preview -->
                                            <div id="imagePreview" class="image-preview-section d-none">
                                                <div class="preview-container">
                                                    <img id="previewImg" src="" alt="معاينة الصورة" class="preview-image">
                                                    <div class="preview-overlay">
                                                        <button type="button" class="btn btn-sm btn-light" id="closePreview">
                                                            <i class="fas fa-arrow-left"></i>
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Date Information Section -->
                                <div class="form-section">
                                    <h6 class="section-title">
                                        <i class="fas fa-calendar-alt text-gold me-2"></i>
                                        التواريخ المهمة
                                    </h6>

                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="form-group-islamic mb-4">
                                                <label asp-for="DateOfBirth" class="form-label-islamic">
                                                    <i class="fas fa-birthday-cake me-2 text-gold"></i>تاريخ الميلاد
                                                </label>
                                                <input asp-for="DateOfBirth" type="date" class="form-control-islamic">
                                                <span asp-validation-for="DateOfBirth" class="validation-message"></span>
                                                <div class="form-help">تاريخ ميلاد الفرد (اختياري)</div>
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <div class="form-group-islamic mb-4">
                                                <label asp-for="DateOfDeath" class="form-label-islamic">
                                                    <i class="fas fa-mosque me-2 text-gold"></i>تاريخ الوفاة
                                                </label>
                                                <input asp-for="DateOfDeath" type="date" class="form-control-islamic">
                                                <span asp-validation-for="DateOfDeath" class="validation-message"></span>
                                                <div class="form-help">تاريخ الوفاة (اتركه فارغاً إذا كان على قيد الحياة)</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Action Buttons -->
                                <div class="form-actions">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <button type="submit" class="btn btn-islamic-success btn-lg w-100">
                                                <i class="fas fa-save me-2"></i>حفظ التعديلات
                                            </button>
                                        </div>
                                        <div class="col-md-6">
                                            <a href="@Url.Action("Index", "Persone")" class="btn btn-islamic-secondary btn-lg w-100">
                                                <i class="fas fa-arrow-left me-2"></i>إلغاء التعديل
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Image preview functionality
        document.getElementById('previewBtn').addEventListener('click', function() {
            const imageUrl = document.getElementById('imageInput').value;
            if (imageUrl) {
                const previewImg = document.getElementById('previewImg');
                const previewSection = document.getElementById('imagePreview');

                previewImg.src = imageUrl;
                previewSection.classList.remove('d-none');

                // Add fade-in animation
                previewSection.style.opacity = '0';
                setTimeout(() => {
                    previewSection.style.opacity = '1';
                }, 10);
            } else {
                alert('الرجاء إدخال رابط الصورة أولاً');
            }
        });

        // Close preview
        document.getElementById('closePreview').addEventListener('click', function() {
            const previewSection = document.getElementById('imagePreview');
            previewSection.style.opacity = '0';
            setTimeout(() => {
                previewSection.classList.add('d-none');
            }, 300);
        });

        // Form validation enhancement
        document.getElementById('editPersonForm').addEventListener('submit', function(e) {
            const nameInput = document.querySelector('input[name="name"]');
            if (!nameInput.value.trim()) {
                e.preventDefault();
                nameInput.focus();
                alert('الرجاء إدخال اسم الفرد');
                return false;
            }
        });

        // Initialize tooltips
        document.addEventListener('DOMContentLoaded', function() {
            const tooltipTriggerList = [].slice.call(document.querySelectorAll('[title]'));
            tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });
        });

        // Searchable Parent Select Functionality
        document.addEventListener('DOMContentLoaded', function() {
            const parentSearch = document.getElementById('parentSearch');
            const parentValue = document.getElementById('parentValue');
            const parentDropdown = document.getElementById('parentDropdown');
            const clearButton = document.getElementById('clearParent');
            const toggleButton = document.getElementById('toggleDropdown');
            const options = parentDropdown.querySelectorAll('.dropdown-option');

            // Toggle dropdown visibility
            function toggleDropdown() {
                parentDropdown.classList.toggle('show');
                const icon = toggleButton.querySelector('i');
                if (parentDropdown.classList.contains('show')) {
                    icon.classList.remove('fa-chevron-down');
                    icon.classList.add('fa-chevron-up');
                } else {
                    icon.classList.remove('fa-chevron-up');
                    icon.classList.add('fa-chevron-down');
                }
            }

            // Hide dropdown
            function hideDropdown() {
                parentDropdown.classList.remove('show');
                const icon = toggleButton.querySelector('i');
                icon.classList.remove('fa-chevron-up');
                icon.classList.add('fa-chevron-down');
            }

            // Show dropdown
            function showDropdown() {
                parentDropdown.classList.add('show');
                const icon = toggleButton.querySelector('i');
                icon.classList.remove('fa-chevron-down');
                icon.classList.add('fa-chevron-up');
            }

            // Filter options based on search
            function filterOptions(searchTerm) {
                const lowercaseSearch = searchTerm.toLowerCase();
                let hasVisibleOptions = false;

                options.forEach(option => {
                    const name = (option.dataset.name || '').toLowerCase();
                    const title = (option.dataset.title || '').toLowerCase();
                    const id = (option.dataset.id || '').toLowerCase();
                    const generation = (option.dataset.generation || '').toLowerCase();
                    const optionText = option.textContent.toLowerCase();

                    // Check if search term matches name, title, ID, generation, or full text
                    const matches = !searchTerm ||
                                  name.includes(lowercaseSearch) ||
                                  title.includes(lowercaseSearch) ||
                                  id.includes(lowercaseSearch) ||
                                  generation.includes(lowercaseSearch) ||
                                  optionText.includes(lowercaseSearch) ||
                                  option.dataset.value === '';

                    if (matches) {
                        option.style.display = 'block';
                        hasVisibleOptions = true;
                    } else {
                        option.style.display = 'none';
                    }
                });

                // Show/hide no results message
                let noResultsMsg = parentDropdown.querySelector('.no-results');
                if (!hasVisibleOptions && searchTerm) {
                    if (!noResultsMsg) {
                        noResultsMsg = document.createElement('div');
                        noResultsMsg.className = 'no-results dropdown-option';
                        noResultsMsg.innerHTML = '<span class="option-text">لا توجد نتائج مطابقة</span>';
                        parentDropdown.appendChild(noResultsMsg);
                    }
                    noResultsMsg.style.display = 'block';
                } else if (noResultsMsg) {
                    noResultsMsg.style.display = 'none';
                }
            }

            // Select an option
            function selectOption(option) {
                const value = option.dataset.value;
                const id = option.dataset.id;
                const name = option.dataset.name;
                const title = option.dataset.title;
                const generation = option.dataset.generation;

                // Update hidden input
                parentValue.value = value;

                // Update search input display
                if (value) {
                    const displayText = `${name} ${title ? `(${title})` : ''} - الجيل ${generation} - ID: ${id}`;
                    parentSearch.value = displayText;
                } else {
                    parentSearch.value = '';
                }

                // Update selected state
                options.forEach(opt => opt.classList.remove('selected'));
                option.classList.add('selected');

                hideDropdown();
            }

            // Clear selection
            function clearSelection() {
                parentValue.value = '';
                parentSearch.value = '';
                options.forEach(opt => opt.classList.remove('selected'));
                // Select the empty option
                const emptyOption = parentDropdown.querySelector('[data-value=""]');
                if (emptyOption) {
                    emptyOption.classList.add('selected');
                }
                hideDropdown();
            }

            // Event listeners
            toggleButton.addEventListener('click', toggleDropdown);
            clearButton.addEventListener('click', clearSelection);

            parentSearch.addEventListener('focus', function() {
                showDropdown();
            });

            parentSearch.addEventListener('input', function() {
                filterOptions(this.value);
                showDropdown();
            });

            // Handle option clicks
            options.forEach(option => {
                option.addEventListener('click', function() {
                    selectOption(this);
                });
            });

            // Close dropdown when clicking outside
            document.addEventListener('click', function(e) {
                if (!e.target.closest('.searchable-select-container')) {
                    hideDropdown();
                }
            });

            // Handle keyboard navigation
            parentSearch.addEventListener('keydown', function(e) {
                const visibleOptions = Array.from(options).filter(opt => opt.style.display !== 'none');
                const currentSelected = parentDropdown.querySelector('.dropdown-option.highlighted');
                let selectedIndex = currentSelected ? visibleOptions.indexOf(currentSelected) : -1;

                switch(e.key) {
                    case 'ArrowDown':
                        e.preventDefault();
                        if (!parentDropdown.classList.contains('show')) {
                            showDropdown();
                        } else {
                            if (currentSelected) currentSelected.classList.remove('highlighted');
                            selectedIndex = (selectedIndex + 1) % visibleOptions.length;
                            visibleOptions[selectedIndex].classList.add('highlighted');
                            visibleOptions[selectedIndex].scrollIntoView({ block: 'nearest' });
                        }
                        break;

                    case 'ArrowUp':
                        e.preventDefault();
                        if (parentDropdown.classList.contains('show')) {
                            if (currentSelected) currentSelected.classList.remove('highlighted');
                            selectedIndex = selectedIndex <= 0 ? visibleOptions.length - 1 : selectedIndex - 1;
                            visibleOptions[selectedIndex].classList.add('highlighted');
                            visibleOptions[selectedIndex].scrollIntoView({ block: 'nearest' });
                        }
                        break;

                    case 'Enter':
                        e.preventDefault();
                        if (currentSelected) {
                            selectOption(currentSelected);
                        }
                        break;

                    case 'Escape':
                        hideDropdown();
                        break;
                }
            });

            // Highlight options on hover
            options.forEach(option => {
                option.addEventListener('mouseenter', function() {
                    options.forEach(opt => opt.classList.remove('highlighted'));
                    this.classList.add('highlighted');
                });
            });

            // Initialize with current selection
            const currentValue = parentValue.value;
            if (currentValue) {
                const selectedOption = parentDropdown.querySelector(`[data-value="${currentValue}"]`);
                if (selectedOption) {
                    selectedOption.classList.add('selected');
                }
            } else {
                const emptyOption = parentDropdown.querySelector('[data-value=""]');
                if (emptyOption) {
                    emptyOption.classList.add('selected');
                }
            }
        });
    </script>

    <style>
        /* === MAIN LAYOUT === */
        .edit-member-page {
            min-height: 100vh;
            background: linear-gradient(135deg, var(--islamic-cream) 0%, #f8f9fa 100%);
            padding-bottom: 3rem;
        }

        /* === PAGE HEADER === */
        .page-header-islamic {
            background: linear-gradient(135deg, var(--islamic-green) 0%, var(--islamic-green-light) 100%);
            color: white;
            padding: 3rem 0;
            margin-bottom: 2rem;
            position: relative;
            overflow: hidden;
        }

        .page-header-islamic::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
